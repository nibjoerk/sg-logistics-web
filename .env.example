# BIC BoxTech (server-side only — do not prefix with PUBLIC_)
BIC_USERNAME=
BIC_PASSWORD=

# Customs declaration self-service (set in Vercel project env)
DATABASE_URL=
CUSTOMS_PIN_PEPPER=
CUSTOMS_SYNC_API_KEY=

# Cloudflare R2 (private PDF store)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sg-customs-pdfs

# Cloudflare Turnstile (CAPTCHA) for /tolldeklarasjon
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sanity CMS
PUBLIC_SANITY_PROJECT_ID=r781ar4i
PUBLIC_SANITY_DATASET=production
# Shared secret for /api/cms/rebuild (set the same in Sanity webhook)
SANITY_REVALIDATE_SECRET=
# Optional legacy: set to 1 to trigger a full Vercel rebuild on article publish.
# CMS article routes are SSR and live without this.
CMS_DEPLOY_ON_PUBLISH=
# Vercel → Project → Settings → Git → Deploy Hooks → Create Hook
VERCEL_DEPLOY_HOOK_URL=
# Optional: debounce window for webhook bursts (default 300000 ms = 5 min)
CMS_REBUILD_DEBOUNCE_MS=

# Server-side Sanity read token (required when dataset is private).
# Prefer Editor if used for rebuild debounce lock writes.
# Required in Vercel for live CMS pages (SSR).
SANITY_API_READ_TOKEN=
