# BIC BoxTech (server-side only — do not prefix with PUBLIC_)
BIC_USERNAME=
BIC_PASSWORD=

# Customs declaration self-service (set in Vercel project env)
DATABASE_URL=
CUSTOMS_PIN_PEPPER=
CUSTOMS_SYNC_API_KEY=

# Cloudflare R2 (private PDF store)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sg-customs-pdfs

# Email for "send future declarations" preference after successful lookup
RESEND_API_KEY=
# Optional — defaults shown
# RESEND_FROM_EMAIL=SG Logistics <noreply@sglogistics.no>
# CUSTOMS_NOTIFY_EMAIL=import@sglogistics.no

# Cloudflare Turnstile (CAPTCHA) for /tolldeklarasjon
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
