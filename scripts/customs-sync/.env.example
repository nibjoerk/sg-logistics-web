# Timpex SQL (SQL authentication)
TIMPEX_SQL_SERVER=sgsenad1
TIMPEX_SQL_DATABASE=TIMPEX_SGL
TIMPEX_SQL_USER=
TIMPEX_SQL_PASSWORD=
# TIMPEX_SQL_ENCRYPT=0

# Same pepper must be set on Vercel as CUSTOMS_PIN_PEPPER
CUSTOMS_PIN_PEPPER=

# Vercel Blob (from Vercel project → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# Deployed site base URL (no trailing slash), e.g. https://sg-logistics-web.vercel.app
CUSTOMS_SYNC_URL=https://sg-logistics-web.vercel.app
CUSTOMS_SYNC_API_KEY=

# Retention window
CUSTOMS_RETENTION_DAYS=90
CUSTOMS_SYNC_BATCH=25
