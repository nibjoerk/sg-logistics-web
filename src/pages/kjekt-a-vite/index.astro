---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import {getKjektListingArticles, setCmsLiveCacheHeaders} from "../../lib/cms-articles";

const articles = await getKjektListingArticles();
setCmsLiveCacheHeaders(Astro.response.headers);

const featuredSlugs = [
  "pakking-av-gods",
  "farlig-gods",
  "incoterms",
  "containerguide",
] as const;

const featuredArticles = featuredSlugs
  .map((slug) => articles.find((article) => article.slug === slug))
  .filter(Boolean);

const categoryOrder = [
  "Pakking",
  "Skade og avvik",
  "Sjøfrakt",
  "Veitransport",
  "Flyfrakt",
  "Regelverk",
  "Import og eksport",
  "Dokumenter",
  "Toll",
  "Annet",
];

const articlesByCategory = [
  ...categoryOrder.map((category) => ({
    category,
    articles: articles.filter((article) => article.category === category),
  })),
  ...[...new Set(articles.map((article) => article.category))]
    .filter((category) => !categoryOrder.includes(category))
    .map((category) => ({
      category,
      articles: articles.filter((article) => article.category === category),
    })),
].filter((group) => group.articles.length > 0);
---

<BaseLayout title="Kjekt å vite | SG Logistics AS" description="Nyttig informasjon om transport, toll, dokumenter og logistikk.">
  <Header />
  <main>
    <section class="section knowledge-page">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Kjekt å vite</p>
          <h1>Nyttig logistikkunnskap samlet på ett sted</h1>
          <p class="section-intro">
            Velg et tema eller start med de mest brukte guidene. Artiklene er samlet etter transportform,
            regelverk, dokumenter og praktisk pakking.
          </p>
        </div>

        <div class="quick-start" aria-label="Anbefalte artikler">
          {featuredArticles.map((article) => (
            article && (
              <a class="featured-card" href={article.href}>
                <span>{article.category}</span>
                <strong>{article.title}</strong>
                <p>{article.intro}</p>
              </a>
            )
          ))}
        </div>

        <nav class="topic-nav" aria-label="Artikkelkategorier">
          {articlesByCategory.map((group) => (
            <a href={`#${group.category.toLowerCase().replaceAll(" ", "-")}`}>
              {group.category}
              <span>{group.articles.length}</span>
            </a>
          ))}
        </nav>

        <div class="article-sections">
          {articlesByCategory.map((group) => (
            <section class="article-section" id={group.category.toLowerCase().replaceAll(" ", "-")}>
              <div class="category-heading">
                <p>{group.articles.length} artikler</p>
                <h2>{group.category}</h2>
              </div>
              <div class="article-list">
                {group.articles.map((article) => (
                  <a class="article-row" href={article.href}>
                    <div>
                      <h3>{article.title}</h3>
                      <p>{article.intro}</p>
                    </div>
                    <span>Les mer →</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .knowledge-page h1 { color: var(--black); font-size: clamp(2.8rem, 5vw, 4.6rem); line-height: 1; letter-spacing: -0.05em; margin-bottom: 20px; max-width: 820px; }
  .quick-start { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin: 36px 0 28px; }
  .featured-card { display: grid; align-content: start; min-height: 220px; padding: 24px; border-radius: 24px; background: var(--white); border: 1px solid rgba(6, 79, 47, .12); text-decoration: none; box-shadow: 0 18px 48px rgba(8, 32, 25, .06); transition: transform .2s ease, border-color .2s ease; }
  .featured-card:hover { transform: translateY(-3px); border-color: rgba(6, 79, 47, .28); }
  .featured-card span, .category-heading p { color: var(--green); font-size: .72rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .featured-card strong { color: var(--black); margin: 12px 0; font-size: 1.28rem; line-height: 1.1; letter-spacing: -.025em; }
  .featured-card p { color: var(--text); margin: 0; line-height: 1.55; }
  .topic-nav { position: sticky; top: 84px; z-index: 5; display: flex; flex-wrap: wrap; gap: 10px; margin: 28px 0 42px; padding: 14px; border-radius: 999px; background: rgba(247, 250, 248, .92); backdrop-filter: blur(14px); border: 1px solid rgba(6, 79, 47, .08); }
  .topic-nav a { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 999px; background: var(--white); color: var(--black); font-weight: 850; text-decoration: none; border: 1px solid rgba(6, 79, 47, .1); }
  .topic-nav span { display: inline-grid; place-items: center; min-width: 24px; height: 24px; border-radius: 999px; background: #eaf5ee; color: var(--green); font-size: .78rem; }
  .article-sections { display: grid; gap: 34px; }
  .article-section { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 28px; align-items: start; padding-top: 12px; scroll-margin-top: 150px; }
  .category-heading { position: sticky; top: 172px; }
  .category-heading p { margin: 0 0 8px; }
  .category-heading h2 { margin: 0; color: var(--black); font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.02; letter-spacing: -.045em; }
  .article-list { display: grid; gap: 12px; }
  .article-row { display: flex; justify-content: space-between; gap: 24px; padding: 22px 24px; border-radius: 22px; background: var(--white); border: 1px solid rgba(6, 79, 47, .1); text-decoration: none; transition: transform .2s ease, border-color .2s ease; }
  .article-row:hover { transform: translateY(-2px); border-color: rgba(6, 79, 47, .28); }
  .article-row h3 { margin: 0 0 6px; color: var(--black); font-size: 1.12rem; line-height: 1.2; }
  .article-row p { margin: 0; color: var(--text); line-height: 1.55; }
  .article-row > span { flex: 0 0 auto; align-self: center; color: var(--green); font-weight: 900; }
  @media (max-width: 980px) { .quick-start { grid-template-columns: repeat(2, minmax(0, 1fr)); } .article-section { grid-template-columns: 1fr; } .category-heading { position: static; } .topic-nav { border-radius: 24px; } }
  @media (max-width: 700px) { .quick-start { grid-template-columns: 1fr; } .featured-card { min-height: auto; } .article-row { display: grid; } .article-row > span { align-self: start; } }
</style>
