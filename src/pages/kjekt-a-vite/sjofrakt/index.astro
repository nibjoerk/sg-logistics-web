---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";

const articles = [
  {
    title: "Containerguide",
    description: "Oversikt over vanlige containertyper med mål, volum, nyttelast og bruksområder.",
    href: "/kjekt-a-vite/containerguide",
  },
  {
    title: "Interaktivt kart over havner i verden",
    description: "Søk i havner fra NGA World Port Index, med UN/LOCODE der tilgjengelig og markering av containerfasiliteter.",
    href: "/kjekt-a-vite/sjofrakt/containerhavner",
  },
  {
    title: "Hvor tung kan en container være på vei?",
    description: "Vektgrenser for containertransport på vei, totalvekt, akseltrykk og landspesifikke regler.",
    href: "/kjekt-a-vite/sjofrakt/hvor-tung-kan-en-container-vaere-pa-vei",
  },
  {
    title: "Containerpakking: stuffing og sikring",
    description: "Praktiske råd for seaworthy packing ved FCL, LCL og containerlasting.",
    href: "/kjekt-a-vite/sjofrakt/containerpakking-stuffing",
  },
  {
    title: "Seaworthy packing",
    description: "Omfattende guide til sjødyktig emballering, materialvalg, merking og håndteringssymboler.",
    href: "/kjekt-a-vite/sjofrakt/seaworthy-packing",
  },
  {
    title: "Hva er FCL?",
    description: "Full Container Load forklart.",
    href: "/kjekt-a-vite/hva-er-fcl",
  },
  {
    title: "Hva er LCL?",
    description: "Less than Container Load forklart.",
    href: "/kjekt-a-vite/hva-er-lcl",
  },
];
---

<BaseLayout
  title="Sjøfrakt | SG Logistics AS"
  description="Kunnskap om sjøfrakt, containere, dokumenter og praktisk planlegging."
>
  <Header />
  <main class="sea-page">
    <section class="sea-hero">
      <div class="container">
        <a class="back-link" href="/kjekt-a-vite">← Kjekt å vite</a>
        <p class="eyebrow">Kjekt å vite</p>
        <h1>Sjøfrakt</h1>
        <p>
          Praktiske artikler om containertransport, sjøfraktdokumenter, vektgrenser,
          pakking og planlegging av import og eksport.
        </p>
      </div>
    </section>

    <section class="sea-list">
      <div class="container grid">
        {articles.map((article) => (
          <a class="card" href={article.href}>
            <span>Sjøfrakt</span>
            <h2>{article.title}</h2>
            <p>{article.description}</p>
            <strong>Les mer →</strong>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .sea-page {
    background: #f7faf8;
    color: #071f18;
  }

  .container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .sea-hero {
    padding: 72px 0 42px;
    background: linear-gradient(180deg, #ffffff 0%, #f7faf8 100%);
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 22px;
    color: #064f2f;
    font-weight: 850;
    text-decoration: none;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: #064f2f;
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 18px;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: .95;
    letter-spacing: -.065em;
  }

  .sea-hero p {
    max-width: 720px;
    margin: 0;
    color: #53645e;
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .sea-list {
    padding: 38px 0 86px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .card {
    display: block;
    padding: 28px;
    border: 1px solid rgba(6, 79, 47, .14);
    border-radius: 24px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 18px 48px rgba(7, 31, 24, .06);
  }

  .card span {
    color: #064f2f;
    font-size: .74rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .card h2 {
    margin: 12px 0;
    font-size: 1.6rem;
    line-height: 1.1;
    letter-spacing: -.04em;
  }

  .card p {
    color: #53645e;
    line-height: 1.6;
  }

  .card strong {
    color: #064f2f;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
