  }

  .calculator-note {
    margin: 18px 0 0;
    color: #52645d;
    font-size: .95rem;
  }

  .checklist h2 {
    margin-top: 0;
  }

  .related a {
    color: #064f2f;
    font-weight: 850;
    text-decoration: none;
  }

  details {
    border-top: 1px solid rgba(6, 79, 47, .12);
    padding: 16px 0;
  }

  details:last-of-type {
