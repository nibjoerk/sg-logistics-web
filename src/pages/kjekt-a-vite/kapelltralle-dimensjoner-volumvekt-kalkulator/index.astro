  }

  summary {
    cursor: pointer;
    color: #082019;
    font-weight: 900;
  }

  details p {
    margin: 12px 0 0;
  }

  .cta {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    margin-top: 46px;
    padding: 28px;
    border-radius: 24px;
    background: #064f2f;
    color: #fff;
  }

  .cta h2,
  .cta p {
    color: #fff;
  }

  .cta h2 {
    margin: 0 0 8px;
  }

  .cta p {
    margin: 0;
    opacity: .88;
  }

  .cta a {
    flex: 0 0 auto;
    display: inline-flex;
    justify-content: center;
