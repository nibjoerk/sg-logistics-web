    };

    function setText(element, value) {
      if (element instanceof HTMLElement) element.textContent = value;
    }

    function selectIncoterm(term) {
      const data = incoterms[term] ?? incoterms.CIF;
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", button.getAttribute("data-incoterm-button") === term ? "true" : "false");
      });
      setText(fields.mode, data.mode);
      setText(fields.title, data.title);
      if (fields.image instanceof HTMLImageElement) {
        fields.image.src = data.image;
        fields.image.alt = `${data.title} illustrasjon`;
      }
      setText(fields.summary, data.summary);
      setText(fields.risk, data.risk);
      setText(fields.costs, data.costs);
      setText(fields.insurance, data.insurance);
      setText(fields.delivery, data.delivery);
      setText(fields.clearance, data.clearance);
      setText(fields.note, data.note);
      if (fields.cargoLink instanceof HTMLElement) {
        fields.cargoLink.hidden = term !== "CIF" && term !== "CIP";
      }
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => selectIncoterm(button.getAttribute("data-incoterm-button") ?? "CIF"));
    });
    document.addEventListener("incoterms:select", (event) => {
      const term = event instanceof CustomEvent ? event.detail?.term : null;
      if (typeof term === "string" && term) selectIncoterm(term);
    });
    selectIncoterm("CIF");
  }
