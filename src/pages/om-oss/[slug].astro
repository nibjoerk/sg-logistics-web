---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ArticleBody from "../../components/article/ArticleBody.astro";
import {buildToc, displayArticleTitle} from "../../lib/sanity-articles";
import {getOmOssArticleBySlug, setCmsLiveCacheHeaders} from "../../lib/cms-articles";

const slug = Astro.params.slug?.trim();
if (!slug) {
  return new Response(null, {status: 404, statusText: "Not Found"});
}

const article = await getOmOssArticleBySlug(slug);
if (!article) {
  return new Response(null, {status: 404, statusText: "Not Found"});
}

setCmsLiveCacheHeaders(Astro.response.headers);

const isGuide = article.layout === "guide";
const toc = article.toc?.length ? article.toc : isGuide ? buildToc(article.body) : [];
const title = displayArticleTitle(article.title);
const seoTitle = displayArticleTitle(article.seoTitle);
---

<BaseLayout title={seoTitle} description={article.seoDescription}>
  <Header />
  <main>
    <article class={`section article-page ${isGuide ? "is-guide" : ""}`}>
      <div class="container article-hero">
        <div class="article-copy">
          <p class="eyebrow">{article.category}</p>
          <h1>{title}</h1>
          <p class="intro">{article.intro}</p>
        </div>

        {article.image && (
          <figure class={`article-hero-media ${isGuide ? "is-full" : ""}`}>
            <img src={article.image.src} alt={article.image.alt} />
          </figure>
        )}
      </div>

      <div class={`container ${isGuide ? "guide-layout" : "article-wrap"}`}>
        {isGuide && toc.length > 0 && (
          <aside class="guide-toc" aria-label="Innhold">
            <strong>Innhold</strong>
            {toc.map((item) => (
              <a href={`#${item.id}`}>{item.label}</a>
            ))}
          </aside>
        )}
        <div class="guide-body">
          <ArticleBody article={article} />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .article-page {
    padding-top: 48px;
    padding-bottom: 88px;
    background: #f7faf8;
  }
  .is-guide {
    background:
      radial-gradient(circle at 82% 12%, rgba(0, 150, 57, .10), transparent 34%),
      linear-gradient(180deg, #ffffff 0%, #f7faf8 42%, #f7faf8 100%);
  }
  .article-wrap { max-width: 820px; }
  .is-guide .container { max-width: 1120px; }
  .article-hero {
    display: grid;
    gap: 28px;
    margin-bottom: 36px;
  }
  .article-page:not(.is-guide) .article-hero {
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
    gap: 36px;
    align-items: end;
  }
  .eyebrow {
    margin: 0 0 12px;
    color: #064f2f;
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    color: #082019;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: .95;
    letter-spacing: -.065em;
  }
  .intro {
    margin: 18px 0 0;
    color: #52645d;
    font-size: 1.12rem;
    line-height: 1.7;
    max-width: 46rem;
  }
  .article-hero-media {
    overflow: hidden;
    margin: 0;
    border-radius: 24px;
    border: 1px solid rgba(6, 79, 47, .12);
    background: #fff;
    box-shadow: 0 18px 48px rgba(8, 32, 25, .08);
  }
  .article-hero-media.is-full {
    border-radius: 30px;
    box-shadow: 0 28px 90px rgba(8, 32, 25, .12);
  }
  .article-hero-media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 240px;
    object-fit: cover;
  }
  .article-hero-media.is-full img {
    height: min(520px, 48vw);
    min-height: 280px;
  }
  .guide-layout {
    display: grid;
    grid-template-columns: 255px minmax(0, 1fr);
    gap: 44px;
    align-items: start;
  }
  .guide-toc {
    position: sticky;
    top: 92px;
    display: grid;
    gap: 10px;
    padding: 22px;
    border: 1px solid rgba(6, 79, 47, .14);
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 18px 45px rgba(8, 32, 25, .06);
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }
  .guide-toc strong {
    margin-bottom: 6px;
    color: #064f2f;
  }
  .guide-toc a {
    color: #52645d;
    text-decoration: none;
    font-size: .95rem;
    font-weight: 750;
    line-height: 1.4;
  }
  .guide-toc a:hover { color: #064f2f; }
  .guide-body {
    padding: 42px;
    border: 1px solid rgba(6, 79, 47, .12);
    border-radius: 30px;
    background: #fff;
    box-shadow: 0 24px 90px rgba(8, 32, 25, .06);
  }
  .guide-body :global(.article-flow),
  .guide-body :global(.article-flow-section),
  .guide-body :global(.article-block),
  .guide-body :global(.stats-block),
  .guide-body :global(.timeline-block) {
    max-width: none;
  }
  .guide-body :global(h2) {
    margin: 44px 0 16px;
    color: #082019;
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    line-height: 1.1;
    letter-spacing: -.04em;
  }
  .guide-body :global(.article-flow:first-child h2),
  .guide-body :global(.article-block:first-child h2),
  .guide-body :global(.richtext:first-child h2),
  .guide-body :global(> :first-child h2) {
    margin-top: 0;
  }
  .guide-body :global(.article-panel),
  .guide-body :global(.article-block),
  .guide-body :global(.article-flow),
  .guide-body :global(.article-flow-section),
  .guide-body :global(.article-inline-image) {
    margin-top: 26px;
  }
  .guide-body :global(> :first-child) {
    margin-top: 0;
  }
  @media (max-width: 900px) {
    .article-page:not(.is-guide) .article-hero,
    .guide-layout { grid-template-columns: 1fr; }
    .guide-toc { position: static; max-height: none; }
    .guide-body { padding: 24px; }
    .article-hero-media.is-full img {
      height: min(360px, 70vw);
      min-height: 220px;
    }
  }
</style>
