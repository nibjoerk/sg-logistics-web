---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ArticleBody from "../../components/article/ArticleBody.astro";
import {buildToc} from "../../lib/sanity-articles";
import {getOmOssArticleBySlug, setCmsLiveCacheHeaders} from "../../lib/cms-articles";

const slug = Astro.params.slug?.trim();
if (!slug) {
  return new Response(null, {status: 404, statusText: "Not Found"});
}

const article = await getOmOssArticleBySlug(slug);
if (!article) {
  return new Response(null, {status: 404, statusText: "Not Found"});
}

setCmsLiveCacheHeaders(Astro.response.headers);

const isGuide = article.layout === "guide";
const toc = article.toc?.length ? article.toc : isGuide ? buildToc(article.body) : [];
---

<BaseLayout title={article.seoTitle} description={article.seoDescription}>
  <Header />
  <main>
    <article class={`section article-page ${isGuide ? "is-guide" : ""}`}>
      <div class={`container ${article.image ? "article-hero-grid" : "article-wrap"}`}>
        <div class="article-copy">
          <p class="eyebrow">{article.category}</p>
          <h1>{article.title}</h1>
          <p class="intro">{article.intro}</p>
        </div>

        {article.image && (
          <div class="article-hero-media">
            <img src={article.image.src} alt={article.image.alt} />
          </div>
        )}
      </div>

      <div class={`container ${isGuide ? "guide-layout" : "article-wrap"}`}>
        {isGuide && toc.length > 0 && (
          <aside class="guide-toc" aria-label="Innhold">
            <strong>Innhold</strong>
            {toc.map((item) => (
              <a href={`#${item.id}`}>{item.label}</a>
            ))}
          </aside>
        )}
        <div class="guide-body">
          <ArticleBody article={article} />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .article-page { padding-top: 48px; padding-bottom: 72px; background: #f7faf8; }
  .article-wrap { max-width: 820px; }
  .article-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
    gap: 36px;
    align-items: end;
    margin-bottom: 36px;
  }
  .eyebrow {
    margin: 0 0 12px;
    color: #064f2f;
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    color: #082019;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    line-height: .98;
    letter-spacing: -.06em;
  }
  .intro {
    margin: 18px 0 0;
    color: #53645e;
    font-size: 1.12rem;
    line-height: 1.7;
  }
  .article-hero-media {
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid rgba(6, 79, 47, .12);
    background: #fff;
    box-shadow: 0 18px 48px rgba(8, 32, 25, .08);
  }
  .article-hero-media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 240px;
    object-fit: cover;
  }
  .guide-layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }
  .guide-toc {
    position: sticky;
    top: 110px;
    display: grid;
    gap: 10px;
    padding: 20px;
    border: 1px solid rgba(6, 79, 47, .12);
    border-radius: 22px;
    background: #fff;
  }
  .guide-toc strong { color: #064f2f; }
  .guide-toc a { color: #53645e; text-decoration: none; font-weight: 750; }
  .guide-body {
    padding: 34px;
    border: 1px solid rgba(6, 79, 47, .12);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 18px 48px rgba(8, 32, 25, .06);
  }
  @media (max-width: 900px) {
    .article-hero-grid,
    .guide-layout { grid-template-columns: 1fr; }
    .guide-toc { position: static; }
    .guide-body { padding: 24px; }
  }
</style>
