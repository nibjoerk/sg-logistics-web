---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";

const title = "Vår historie";
const description =
  "Historien om Sunnmøre Gods og SG Logistics, fra fast godsrute mellom Bergen og Sunnmøre til dagens internasjonale logistikkpartner i Ålesund.";

const milestones = [
  {
    year: "1932",
    title: "Fast godsrute",
    text: "Ole Pettersen startet godsruten mellom Bergen og Sunnmøre med M/S Leif Erikson.",
  },
  {
    year: "1969",
    title: "M/S Torvald Erikson",
    text: "Et nytt pallebygget M/S Torvald Erikson ble levert fra Fiskerstrand.",
  },
  {
    year: "1970",
    title: "Prestebrygga",
    text: "Sunnmøre Godsekspedisjon AS startet virksomheten i Ålesund 31. mars 1970.",
  },
  {
    year: "1976",
    title: "Rent spedisjonsselskap",
    text: "Selskapet valgte å betjene flere frakteselskap, og M/S Torvald Erikson ble solgt.",
  },
  {
    year: "1978",
    title: "Flytting til Spjelkavik",
    text: "Virksomheten flyttet til Spjelkavik og videreutviklet rollen som speditør.",
  },
  {
    year: "1987",
    title: "Flytting til Breivika",
    text: "Flyttingen til Breivika ga større terminalarealer, kai og rom for videre vekst.",
  },
  {
    year: "1988",
    title: "Sunnmøre Gods AS",
    text: "Selskapet endret navn fra Sunnmøre Godsekspedisjon AS til Sunnmøre Gods AS.",
  },
  {
    year: "1990",
    title: "Ro/ro-forbindelse til Europa",
    text: "Sunnmøre Gods ble agent i Ålesund for en ukentlig ro/ro-forbindelse til Bremerhaven.",
  },
  {
    year: "1994",
    title: "North Sea Container Line",
    text: "Selskapet deltok i etableringen av North Sea Container Line.",
  },
  {
    year: "1998",
    title: "Nytt kontorbygg",
    text: "Sunnmøre Gods flyttet inn i nytt kontorbygg i Breivika.",
  },
  {
    year: "2001",
    title: "Kuehne + Nagel",
    text: "Driftsselskapet Sunnmøre Gods AS ble solgt til Kuehne + Nagel.",
  },
  {
    year: "2005",
    title: "SG Logistics etableres",
    text: "SG Logistics startet opp som et nytt lokalt spedisjonsselskap med bilfrakt som hovedaktivitet.",
  },
  {
    year: "2007",
    title: "Flyfrakt og sjøfrakt",
    text: "SG Logistics utvidet med egne avdelinger for flyfrakt og sjøfrakt.",
  },
  {
    year: "2008",
    title: "Sterk vekst",
    text: "Driftsinntektene nådde 57,7 millioner kroner.",
  },
  {
    year: "2020",
    title: "Lederskifte",
    text:
      "Nils Erik Bjørkedal overtok som daglig leder etter Leif Otto Nesseth, som hadde ledet SG Logistics siden etableringen.",
  },
];

const stats = [
  { value: "1932", label: "Fast godsrute mellom Bergen og Sunnmøre" },
  { value: "1970", label: "Sunnmøre Godsekspedisjon i drift" },
  { value: "2005", label: "SG Logistics etablert" },
  { value: "2020", label: "Lederskifte i SG Logistics" },
];
---

<BaseLayout title={`${title} | SG Logistics AS`} description={description}>
  <Header />

  <main class="history-page">
    <section class="history-hero">
      <div class="container hero-grid">
        <div>
          <a class="back-link" href="/#om-oss">← Om SG Logistics</a>
          <p class="eyebrow">Om SG Logistics</p>
          <h1>Fra kystrute til moderne logistikk.</h1>
          <p class="lead">
            Historien om SG Logistics handler om lokale røtter, langsiktig utvikling og evnen
            til å finne nye løsninger når markedet endrer seg.
          </p>
        </div>

        <div class="hero-card">
          <span>Lokale røtter</span>
          <strong>Hele verden som arbeidsområde.</strong>
          <p>
            Fra en fast godsrute mellom Bergen og Sunnmøre i 1932, via Sunnmøre Gods og Breivika,
            går det en tydelig linje fram til dagens SG Logistics.
          </p>
        </div>
      </div>

      <div class="container">
        <figure class="hero-image">
          <img
            src="/images/om-oss/sg-logistics-breivika-i-dag.png"
            alt="Flyfoto av SG Logistics sine lokaler i Breivika i Ålesund slik anlegget ser ut i dag"
            loading="eager"
          />
          <figcaption>SG Logistics i Breivika i Ålesund i dag.</figcaption>
        </figure>
      </div>
    </section>

    <section class="stats-section">
      <div class="container stats-grid">
        {stats.map((item) => (
          <div class="stat-card">
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="history-content">
      <div class="container content-grid">
        <aside class="toc" aria-label="Innhold">
          <strong>Innhold</strong>
          <a href="#rotter">Røttene langs kysten</a>
          <a href="#godsekspedisjon">Sunnmøre Godsekspedisjon</a>
          <a href="#breivika">Et nytt knutepunkt i Breivika</a>
          <a href="#internasjonal">Internasjonal vekst</a>
          <a href="#europa">Nye sjøveier til Europa</a>
          <a href="#sg-logistics">SG Logistics etableres</a>
          <a href="#videre">Historien lever videre</a>
        </aside>

        <article>
          <section class="intro-section">
            <p>
              Fra en fast godsrute mellom Bergen og Sunnmøre i 1932, via Sunnmøre Gods og den
              internasjonale veksten i Breivika, går det en tydelig linje fram til dagens SG Logistics.
              Historien er en fortelling om mennesker, relasjoner og kontinuerlig utvikling.
            </p>
          </section>

          <h2 id="rotter">Røttene langs kysten</h2>
          <p>
            Historien begynte flere tiår før etableringen av Sunnmøre Gods. Den 1. september 1932
            startet Ole Pettersen en fast godsrute mellom Bergen og Sunnmøre med M/S Leif Erikson.
          </p>
          <figure class="wide-image">
            <img
              src="/images/om-oss/ms-leif-erikson-godsrute-1932.png"
              alt="M/S Leif Erikson, skipet som gikk i fast godsrute mellom Bergen og Sunnmøre"
              loading="lazy"
            />
            <figcaption>M/S Leif Erikson, knyttet til godsruten mellom Bergen og Sunnmøre fra 1932.</figcaption>
          </figure>
          <p>
            Skipet gikk fra Bergen til en rekke steder langs kysten og i de sunnmørske fjordene.
            Ruten knyttet lokalsamfunn og næringsliv på Sunnmøre tettere sammen med Bergen og
            transportforbindelsene videre sørover. Lasten bestod blant annet av kunstgjødsel, frø,
            levertran og andre varer.
          </p>
          <figure class="document-image">
            <img
              src="/images/om-oss/godsrute-ms-leif-erikson-1932.png"
              alt="Faksimile av annonse for godsrute med M/S Leif Erikson fra 1. september 1932"
              loading="lazy"
            />
            <figcaption>Faksimile av annonsen for godsruten med M/S Leif Erikson fra 1. september 1932.</figcaption>
          </figure>
          <p>
            Gjennom årene ble ruten videreutviklet og betjent av flere fartøy. I 1969 ble et nytt
            M/S Torvald Erikson levert fra Fiskerstrand Slipp & Mek. Verksted. Det var det tredje
            skipet som bar navnet Torvald Erikson, bygget som pallebåt og med langt større lastekapasitet
            enn forgjengeren. I forbindelse med overtakelsen fikk den rundt 40 år gamle godsruten navnet
            Sunnmørsruten.
          </p>
          <figure class="wide-image">
            <img
              src="/images/om-oss/ms-torvald-erikson-sunnmorsruta.png"
              alt="M/S Torvald Erikson fra Sunnmørsruta"
              loading="lazy"
            />
            <figcaption>M/S Torvald Erikson, som trafikkerte Sunnmørsruta på slutten av 1960-tallet.</figcaption>
          </figure>

          <h2 id="godsekspedisjon">Sunnmøre Godsekspedisjon blir etablert</h2>
          <p>
            Petter O. Pettersen, senere Petter O. Notø, var kaptein på det nye skipet. Da
            agentvirksomheten i Ålesund ble avviklet i 1969, oppstod behovet for en ny lokal
            godsekspedisjon. Sammen med Tor Nitter Foss og Lars Sandvik etablerte han Sunnmøre
            Godsekspedisjon AS.
          </p>
          <p>
            Selskapet startet virksomheten på Prestebrygga i Ålesund 31. mars 1970. De første årene
            var hovedoppgaven å håndtere gods og ekspedisjon for Sunnmørsruten.
          </p>
          <p>
            I 1976 ble det tatt et viktig strategivalg. Sunnmøre Godsekspedisjon skulle heretter være
            et rent spedisjonsselskap som betjente flere frakteselskap, og M/S Torvald Erikson ble solgt.
            Det ble innledet samarbeid med flere andre frakteselskap, blant annet hadde Sunnmøre
            Godsekspedisjon all ekspedering i Ålesund for Stavangerske Mørerutene.
          </p>
          <h2>Fra Prestebrygga til Spjelkavik</h2>
          <p>
            Gjennom 1970-årene vokste virksomheten, og nye transportformer fikk større betydning.
            Selskapet utviklet tjenester innen biltransport, sjøfrakt, flyfrakt, fortolling og
            internasjonal spedisjon. I 1978 ble virksomheten flyttet til Spjelkavik, samtidig som
            selskapet rendyrket rollen som speditør og transportformidler.
          </p>
          <p>
            På 1980-tallet ble containertrafikken stadig viktigere. Sunnmøre Gods bygget opp kompetanse
            og samarbeid som koblet næringslivet på Sunnmøre tettere til internasjonale markeder.
            Veksten førte samtidig til behov for større og mer hensiktsmessige arealer.
          </p>

          <h2 id="breivika">Et nytt knutepunkt i Breivika</h2>
          <p>
            I 1986 kjøpte Sunnmøre Gods eiendommen til Westcon AS i Breivika. Her kunne selskapet
            utvikle et moderne terminalanlegg med lager, kontorer, store utearealer, egen kai og gode
            forbindelser mellom sjø- og landtransport.
          </p>
          <p>
            Flyttingen til Breivika ble gjennomført i romjulen 1987. Anlegget ga et langt bedre
            grunnlag for videre vekst. Terminalen ble etter hvert bygget ut med dypvannskai og
            ro/ro-rampe og utviklet seg til et viktig logistikk-knutepunkt i Ålesund.
          </p>
          <p>
            I 1988 endret selskapet navn fra Sunnmøre Godsekspedisjon AS til Sunnmøre Gods AS. Ti år
            senere, i 1998, flyttet virksomheten inn i nytt kontorbygg i Breivika. Det styrket terminalen
            som base for videre vekst innen sjøfrakt, bilfrakt og internasjonal spedisjon.
          </p>
          <figure class="wide-image">
            <img
              src="/images/om-oss/sunnmore-gods-kontorbygg-breivika-1998.png"
              alt="Sunnmøre Gods sitt nye kontorbygg i Breivika, som selskapet flyttet inn i romjulen 1998"
              loading="lazy"
            />
            <figcaption>
              Det blå kontorbygget til venstre i bildet ble tatt i bruk av Sunnmøre Gods i romjulen
              1998, og er fortsatt der SG Logistics holder til i dag.
            </figcaption>
          </figure>
          <figure class="wide-image">
            <img
              src="/images/om-oss/sunnmore-gods-terminal-breivika-etter-1988.png"
              alt="Sunnmøre Gods sin terminal i Breivika etter utbyggingen"
              loading="lazy"
            />
            <figcaption>Sunnmøre Gods sin terminal i Breivika, tatt en gang etter 1988.</figcaption>
          </figure>

          <h2 id="internasjonal">Fra regional transportør til internasjonal logistikkaktør</h2>
          <p>
            Gjennom 1980- og 1990-årene utviklet Sunnmøre Gods seg fra en regional transport- og
            ekspedisjonsbedrift til en internasjonal logistikkaktør. Målet var å bygge et rendyrket
            speditørselskap som kunne finne gode transportløsninger på tvers av transportformer,
            regionalt, nasjonalt og internasjonalt.
          </p>
          <p>
            Fra terminalen i Breivika organiserte selskapet transport med skip, bil og fly.
            Sjømatnæringen ble et særlig viktig marked. Mot slutten av 1990-årene håndterte
            Sunnmøre Gods rundt 2 800 containere med frossen fisk i året og hadde ansvar for transport
            av om lag 56 000 tonn fisk fra mottak til markeder over hele verden.
          </p>
          <p>
            Virksomheten hadde på dette tidspunktet vokst til rundt 25 medarbeidere og en omsetning
            på over 120 millioner kroner. Den moderne terminalen i Breivika, med dypvannskai og store
            terminalarealer, gjorde det mulig å tilby komplette transportløsninger fra avsender til marked.
          </p>
          <figure class="wide-image">
            <img
              src="/images/om-oss/sunnmore-gods-terminal-sjofrakt-1990-tallet.png"
              alt="Sjøfrakt og terminalaktivitet hos Sunnmøre Gods på 1990-tallet"
              loading="lazy"
            />
            <figcaption>Sjøfrakt og terminalaktivitet hos Sunnmøre Gods på 1990-tallet.</figcaption>
          </figure>

          <h2 id="europa">Nye ruter og nye muligheter</h2>
          <p>
            Sunnmøre Gods var involvert i utviklingen av nye sjøtransportløsninger. I 1990 ble en
            ukentlig ro/ro-forbindelse mellom Nord-Norge, Ålesund, Måløy og Bremerhaven etablert,
            med Sunnmøre Gods som agent i Ålesund.
          </p>
          <p>
            Selskapet var også med på etableringen av North Sea Container Line i 1994, som utviklet
            containertrafikk mellom Vestlandet, Storbritannia og Rotterdam. Mot slutten av 1990-årene
            ble nettverket ytterligere utvidet. Nye forbindelser og langsiktige transportavtaler styrket
            sjøtransporten fra Vestlandet og ga kundene tilgang til flere europeiske markeder.
          </p>

          <h2>Sunnmøre Gods blir en del av Kuehne + Nagel</h2>
          <p>
            Etter tre tiår med vekst ble driftsselskapet Sunnmøre Gods AS solgt til Kuehne + Nagel.
            Overtakelsen fikk virkning fra 1. april 2001. Virksomheten i Breivika ble videreført, og
            den lokale kompetansen ble en del av et verdensomspennende logistikknettverk.
          </p>
          <p>
            Leif Otto Nesseth ble daglig leder for virksomheten i Ålesund. Han hadde selv en lang
            historie i Sunnmøre Gods og hadde hatt en rekke roller i selskapet. Petter O. Notø gikk av
            med pensjon i 2002 etter å ha ledet utviklingen fra den tidlige godsekspedisjonen til et
            stort og internasjonalt orientert logistikkmiljø.
          </p>

          <h2 id="sg-logistics">En ny start: SG Logistics</h2>
          <p>
            Etter tiden i Kuehne + Nagel tok historien en ny retning. Leif Otto Nesseth etablerte i
            2005 et nytt selskap sammen med familien Notø, med en eierandel på 50 prosent hver.
            Selskapet ble operativt fra 1. april 2005. Etter en navneendring fikk virksomheten navnet
            SG Logistics AS.
          </p>
          <p>
            Ved oppstarten bestod selskapet av Leif Otto Nesseth, Torgeir E. Stene og Trude
            Fiskerstrand, med Åse Haram i en deltidsstilling innen regnskap. Flere av medarbeiderne
            hadde bakgrunn fra Sunnmøre Gods, og den nye virksomheten bygget videre på mange tiår med
            erfaring, relasjoner og logistikkkompetanse.
          </p>
          <p>
            I starten drev SG Logistics kun med bilfrakt. I 2007 ble virksomheten utvidet med egne
            avdelinger for flyfrakt og sjøfrakt, og selskapet fikk dermed et bredere tjenestetilbud
            innen internasjonal transport.
          </p>
          <figure class="document-image">
            <img
              src="/images/om-oss/stillingsannonse-sunnmorsposten-februar-2005.png"
              alt="Faksimile fra stillingsannonsen i Sunnmørsposten februar 2005"
              loading="lazy"
            />
            <figcaption>Faksimile fra stillingsannonsen i Sunnmørsposten februar 2005.</figcaption>
          </figure>
          <div class="image-grid">
            <figure>
              <img
                src="/images/om-oss/sg-logistics-apning-2005-medarbeidere.png"
                alt="Medarbeidere i SG Logistics under åpningen 1. april 2005"
                loading="lazy"
              />
              <figcaption>Fra åpningen av SG Logistics 1. april 2005.</figcaption>
            </figure>
            <figure>
              <img
                src="/images/om-oss/sg-logistics-apning-2005-kake.png"
                alt="Kake og markering under åpningen av SG Logistics 1. april 2005"
                loading="lazy"
              />
              <figcaption>Markering av oppstarten 1. april 2005.</figcaption>
            </figure>
          </div>

          <h2 id="vekst">Sterk vekst og nye muligheter</h2>
          <p>
            Veksten kom raskt. Driftsinntektene økte fra 5,2 millioner kroner i 2005 til 15,1 millioner
            i 2006, 32,2 millioner i 2007 og 57,7 millioner kroner i 2008. I løpet av få år hadde
            SG Logistics etablert seg som en betydelig aktør innen spedisjon og internasjonal transport.
          </p>
          <figure class="wide-image">
            <img
              src="/images/om-oss/leif-otto-nesseth-terminalen-2008.png"
              alt="Leif Otto Nesseth utenfor terminalen i 2008"
              loading="lazy"
            />
            <figcaption>Leif Otto Nesseth utenfor terminalen i 2008.</figcaption>
          </figure>
          <p>
            Finanskrisen førte samtidig til store endringer i transportmarkedet. Etter en periode med
            høy etterspørsel og begrenset transportkapasitet ble konkurransen sterkere og prispresset
            større. SG Logistics tilpasset seg de nye markedsforholdene og fortsatte å utvikle virksomheten.
          </p>
          <p>
            Et eksempel på bredden i virksomheten kom i 2012, da SG Logistics organiserte transporten
            av en stor rørtrommel fra Danmark til Subsea7 på Vigra. Trommelen veide rundt 40 tonn og
            var 9,5 meter i diameter. Oppdraget krevde omfattende planlegging, sjøtransport og
            spesialhåndtering.
          </p>
          <figure class="wide-image">
            <img
              src="/images/om-oss/rortrommel-vigra-spesialtransport-2012.png"
              alt="Flytting av stor rørtrommel på Vigra i 2012"
              loading="lazy"
            />
            <figcaption>
              Flytting av rørtrommel på Vigra i 2012, et eksempel på SG Logistics sin evne til å
              håndtere krevende spesialtransporter.
            </figcaption>
          </figure>

          <h2>Lederskifte i 2020</h2>
          <p>
            I 2020 overtok Nils Erik Bjørkedal som daglig leder etter Leif Otto Nesseth, som hadde
            ledet SG Logistics siden etableringen i 2005. Bjørkedal hadde lang erfaring fra
            logistikkbransjen og fikk ansvar for å videreutvikle virksomheten, styrke kunderelasjonene
            og skape ny vekst.
          </p>
          <p>
            Leif Otto Nesseth fortsatte som styreleder, mens den daglige ledelsen ble overført til
            Nils Erik Bjørkedal.
          </p>
          <figure class="wide-image portrait-image">
            <img
              src="/images/om-oss/lederskifte-sg-logistics-2020.png"
              alt="Leif Otto Nesseth og Nils Erik Bjørkedal ved lederskiftet i SG Logistics i 2020"
              loading="lazy"
            />
            <figcaption>
              Lederskifte i SG Logistics i 2020: Leif Otto Nesseth og Nils Erik Bjørkedal.
            </figcaption>
          </figure>

          <div class="quote-box" id="videre">
            <p>
              Lokale røtter. Hele verden som arbeidsområde.
            </p>
          </div>

          <h2>Videre med erfaring, nærhet og nye løsninger</h2>
          <p>
            SG Logistics har siden utviklet seg videre som en uavhengig logistikkpartner med hovedkontor
            i Breivika. Selskapet tilbyr transport- og logistikkløsninger på vei, sjø og i luften,
            med hele verden som arbeidsområde.
          </p>
          <p>
            Mye har endret seg siden den første godsruten startet i 1932. Skipene, terminalene,
            teknologien og markedene er nye. Likevel er flere av grunnverdiene de samme: nærhet til
            kundene, solid fagkunnskap, fleksibilitet og viljen til å finne løsninger.
          </p>
          <p>
            Historien fra M/S Leif Erikson og Sunnmørsruten, via Sunnmøre Gods og fram til dagens
            SG Logistics, er derfor ikke bare en fortelling om transport. Den er en fortelling om
            mennesker, langsiktige relasjoner og kontinuerlig utvikling, med sterke røtter på Sunnmøre
            og verden som arbeidsområde.
          </p>

          <section class="timeline-section">
            <div class="section-heading">
              <p class="eyebrow">Tidslinje</p>
              <h2>Viktige år i historien</h2>
            </div>

            <div class="timeline">
              {milestones.map((item) => (
                <div class="timeline-item">
                  <span>{item.year}</span>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <div class="cta">
            <div>
              <h2>Vil du vite mer om SG Logistics?</h2>
              <p>
                Ta kontakt med oss, så forteller vi gjerne mer om hvordan erfaringen vår kan brukes i
                dine transport- og logistikkbehov.
              </p>
            </div>
            <a href="/#kontakt">Kontakt oss</a>
          </div>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .history-page {
    background: #f7faf8;
    color: #082019;
  }

  .container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .history-hero {
    padding: 76px 0 56px;
    background:
      radial-gradient(circle at 84% 18%, rgba(0, 150, 57, .12), transparent 34%),
      linear-gradient(180deg, #ffffff 0%, #f7faf8 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 48px;
    align-items: end;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 22px;
    color: #064f2f;
    font-weight: 800;
    text-decoration: none;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #064f2f;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-size: .78rem;
  }

  h1 {
    max-width: 880px;
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5.4rem);
    line-height: .95;
    letter-spacing: -.065em;
  }

  .lead {
    max-width: 760px;
    margin: 24px 0 0;
    color: #52645d;
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .hero-card {
    padding: 28px;
    border: 1px solid rgba(6, 79, 47, .14);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 24px 80px rgba(8, 32, 25, .08);
  }

  .hero-card span {
    display: block;
    margin-bottom: 10px;
    color: #064f2f;
    font-size: .78rem;
