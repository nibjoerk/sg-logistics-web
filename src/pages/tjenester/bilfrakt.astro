---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ServicePageHero from "../../components/ServicePageHero.astro";
import ContentSection from "../../components/ContentSection.astro";
import bilfraktImage from "../../assets/images/Bilfrakt.png";

const ltlLeadTimes = [
  { countries: "Sverige*, Nederland, Belgia", wed: "Starten av neste uke", fri: "Starten/midten av neste uke" },
  { countries: "Danmark*", wed: "Starten til midten av neste uke", fri: "Starten til slutten av neste uke" },
  { countries: "Tyskland, Østerrike, Sveits, Liechtenstein", wed: "Starten/midten av neste uke", fri: "Slutten av neste uke" },
  { countries: "Frankrike*", wed: "Starten til slutten av neste uke", fri: "Slutten av neste uke til uke 2" },
  { countries: "Polen", wed: "Midten/slutten av neste uke", fri: "Slutten av neste uke" },
  { countries: "Italia*", wed: "Midten til slutten av neste uke", fri: "Slutten av neste uke til uke 2" },
  { countries: "Spania*, Latvia", wed: "Midten/slutten av neste uke", fri: "Slutten av neste uke til uke 2" },
  { countries: "Portugal", wed: "Slutten av neste uke", fri: "Slutten av uke 2" },
  { countries: "Romania", wed: "Slutten av neste uke til uke 2", fri: "Starten/midten av uke 2" },
  { countries: "Storbritannia*, Slovakia, Ungarn", wed: "Slutten av neste uke til uke 2", fri: "Midten av uke 2" },
  { countries: "Tyrkia", wed: "Slutten av neste uke til uke 2", fri: "Midten/slutten av uke 2" },
];
---

<BaseLayout
  title="Bilfrakt og veitransport | SG Logistics AS"
  description="Internasjonal veitransport, stykkgods, partilast, full-loads og ekspress mellom Norge og Europa."
>
  <Header />
  <main>
    <ServicePageHero
      eyebrow="Veitransport"
      title="Stykkgods, full-loads og ekspress mellom Norge og Europa."
      lead="SG Logistics tilbyr pålitelige veitransporter for bedrifter som trenger forutsigbarhet, personlig oppfølging og god kontroll på hele transportkjeden."
      image={bilfraktImage}
      imageAlt="SG Logistics bilfrakt på vei i norsk fjordlandskap"
    />

    <p class="bilfrakt-note section-shell">
      Merk: Vi tilbyr bilfrakt for gods på lastebil – ikke transport av personbiler.
      Skal du flytte en bil fra A til B, er det andre aktører som passer bedre.
    </p>

    <ContentSection
      eyebrow="LTL"
      title="Stykkgods med faste avganger"
      intro="Vårt hovedprodukt på vei er internasjonal stykkgodstrafikk mellom Norge og Europa."
    >
      <p>
        Vi har faste eksportavganger fra Norge hver onsdag og fredag. Flere semitrailere går via Danmark
        for omlasting og videre distribusjon til destinasjoner i Europa. På import følger transporten
        motsatt rute, med typiske ankomster til Norge tirsdag og torsdag.
      </p>
      <p>
        En viktig styrke er at løsningene våre har færre omlastinger enn mange alternative nettverk.
        Ofte er det linjebilene som henter og leverer godset hos kundene. Det gir færre håndteringer,
        bedre kontroll og lavere risiko for skade.
      </p>
      <p>
        Vi bruker faste sjåfører som kjenner norske veier, vinterforhold og lokale leveringssteder godt.
        Det gir bedre kommunikasjon, færre misforståelser og mer forutsigbar gjennomføring.
      </p>
    </ContentSection>

    <section class="ltl-leadtimes section-shell">
      <div class="ltl-leadtimes__header">
        <p class="service-eyebrow">Ledetider</p>
        <h2>Typiske LTL-ledetider fra Norge</h2>
        <p class="ltl-leadtimes__intro">
          Typisk ankomstuke ved avgang onsdag eller fredag, med omlasting i Herning, Danmark.
          Land merket med * varierer etter postnummer.
        </p>
      </div>

      <div class="ltl-leadtimes__layout">
        <div class="ltl-leadtimes__table-side">
          <div class="ltl-leadtimes__table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Land</th>
                  <th scope="col">Avgang onsdag</th>
                  <th scope="col">Avgang fredag</th>
                </tr>
              </thead>
              <tbody>
                {ltlLeadTimes.map((row) => (
                  <tr>
                    <th scope="row">{row.countries}</th>
                    <td>{row.wed}</td>
                    <td>{row.fri}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="ltl-leadtimes__footnote">
            * Varierer etter postnummer — ta kontakt for mer info
          </p>
        </div>

        <figure class="ltl-leadtimes__map">
          <img
            src="/images/articles/europe-map-ltl.jpg"
            alt="Europakart som viser LTL-nettverk via Herning i Danmark til og fra flere land"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Omlasting i Herning – videre ut i Europa</figcaption>
        </figure>
      </div>
    </section>

    <ContentSection
      eyebrow="FTL"
      title="Full-loads og partilast"
      intro="Når sendingen fyller hele bilen, eller krever direkte levering, tilbyr vi dedikerte transportløsninger."
    >
      <p>
        Full-loads går normalt direkte fra avsender til mottaker uten unødvendige omlastinger. Dette
        gir kortere transittid, mindre håndtering og høyere leveringssikkerhet.
      </p>
      <p>
        Vi håndterer blant annet industrigods, fiskemel, fiskeolje og andre større varepartier.
        Transportene planlegges etter kundens produksjon, lastetidspunkt, leveringskrav og mottakers behov.
      </p>
      <p>
        Vi kan stille bil på kort varsel og finner løsninger når kapasitet, leveringstid eller rutevalg
        krever ekstra oppfølging.
      </p>
    </ContentSection>

    <ContentSection eyebrow="Tidskritisk" title="Ekspress, ADR og spesialbehov">
      <p>
        Noen leveranser kan ikke vente. Ved tidskritiske transporter kan vi sette opp ekspressbil,
        eventuelt med to sjåfører for å redusere transporttiden innenfor gjeldende kjøre- og hviletidsregler.
      </p>
      <p>
        Vi tilbyr også ADR-transport der godset krever dette, og bistår med nødvendig koordinering og
        dokumentasjon.
      </p>
      <p>Vi transporterer ikke temperaturkontrollert gods på vei.</p>
    </ContentSection>

    <ContentSection eyebrow="Derfor" title="Hvorfor velge SG Logistics på vei?">
      <ul>
        <li>Personlig oppfølging og rask respons.</li>
        <li>Faste avganger mellom Norge og Europa.</li>
        <li>Færre omlastinger og lav skadefrekvens.</li>
        <li>Erfarne sjåfører som kjenner norske forhold.</li>
        <li>Fleksible løsninger for LTL, FTL, partilast og ekspress.</li>
        <li>Hjelp med transportdokumenter, toll og avvikshåndtering.</li>
      </ul>
    </ContentSection>
  </main>
  <Footer />
</BaseLayout>

<style>
  .bilfrakt-note.section-shell {
    width: min(100% - clamp(2rem, 6vw, 7rem), var(--max-width, 1200px));
    margin: 0 auto;
    padding: 0 0 0.25rem;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .ltl-leadtimes.section-shell {
    width: min(100% - clamp(2rem, 6vw, 7rem), var(--max-width, 1200px));
    margin-inline: auto;
    padding-block: clamp(1.5rem, 3vw, 2.4rem);
    border-top: 1px solid var(--border);
  }

  .ltl-leadtimes__header {
    max-width: 720px;
    margin-bottom: 12px;
  }

  .service-eyebrow {
    color: var(--green);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
  }

  .ltl-leadtimes h2 {
    margin: 0 0 6px;
    color: var(--black);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .ltl-leadtimes__intro {
    margin: 0;
    color: var(--text);
    line-height: 1.4;
    font-size: 0.88rem;
  }

  .ltl-leadtimes__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(260px, 1.08fr);
    gap: 22px;
    align-items: start;
  }

  .ltl-leadtimes__table-side {
    min-width: 0;
  }

  .ltl-leadtimes__table-wrap {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 5px 8px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    font-size: 0.78rem;
    line-height: 1.3;
    vertical-align: top;
  }

  thead th {
    background: var(--light);
    color: var(--black);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  tbody th {
    color: var(--black);
    font-weight: 700;
  }

  tbody td {
    color: var(--text);
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .ltl-leadtimes__footnote {
    margin: 8px 0 0;
    color: var(--text);
    font-size: 0.78rem;
  }

  .ltl-leadtimes__map {
    margin: 0;
    position: sticky;
    top: 96px;
  }

  .ltl-leadtimes__map img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--light);
  }

  .ltl-leadtimes__map figcaption {
    margin-top: 8px;
    color: var(--text);
    font-size: 0.8rem;
  }

  @media (max-width: 980px) {
    .ltl-leadtimes__layout {
      grid-template-columns: 1fr;
    }

    .ltl-leadtimes__map {
      position: static;
      order: -1;
      max-width: 520px;
    }
  }

  @media (max-width: 640px) {
    .bilfrakt-note.section-shell,
    .ltl-leadtimes.section-shell {
      width: min(100% - 2rem, var(--max-width, 1200px));
    }
  }
</style>
