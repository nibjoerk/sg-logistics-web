---
import IncotermsWizard from "../IncotermsWizard.astro";
import { getArticleBlockType, type Article, type ArticleSectionBlock } from "../../data/articleTypes";
import { allocateHeadingId, paragraphsFromPlainText } from "../../lib/sanity-articles";

interface Props {
  article: Article;
  showLegacyIncoterms?: boolean;
  showLegacyLiability?: boolean;
}

const { article, showLegacyIncoterms = false, showLegacyLiability = false } = Astro.props;

const isExternalHref = (href: string) =>
  /^https?:\/\//i.test(href) || href.startsWith("mailto:") || href.startsWith("tel:");

const headingIds = new Set<string>();
function headingId(label: string | undefined) {
  if (!label) return undefined;
  return allocateHeadingId(label, headingIds) || undefined;
}

const isYearLabel = (label: string | undefined) => Boolean(label && /^\d{4}$/.test(label.trim()));
---

{
  article.body.map((block, index) => {
    const type = getArticleBlockType(block);

    if (type === "richText" && block._type === "richText") {
      return (
        <div class="article-flow richtext" set:html={block.html} />
      );
    }

    if (type === "imageBlock" && block._type === "imageBlock") {
      return (
        <figure class="article-inline-image article-flow-image">
          <button
            type="button"
            data-full-image={block.image.src}
            data-full-image-alt={block.image.alt}
            aria-label="Vis bildet i full størrelse"
          >
            <img src={block.image.src} alt={block.image.alt} loading="lazy" />
          </button>
          {block.image.caption && <figcaption>{block.image.caption}</figcaption>}
        </figure>
      );
    }

    if (type === "callout" && block._type === "callout") {
      return (
        <aside class={`article-panel notice notice-${block.tone}`}>
          {block.label && <strong>{block.label}</strong>}
          <div class="richtext" set:html={block.html} />
        </aside>
      );
    }

    if (type === "checklist" && block._type === "checklist") {
      return (
        <section class="article-panel checklist">
          {block.heading && <h2 id={headingId(block.heading)}>{block.heading}</h2>}
          <ul>
            {block.items.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      );
    }

    if (type === "warning" && block._type === "warning") {
      return (
        <section class="article-panel warning-box">
          {block.heading && <h2 id={headingId(block.heading)}>{block.heading}</h2>}
          <ul>
            {block.items.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      );
    }

    if (type === "infoCards" && block._type === "infoCards") {
      const timelineCards = block.cards.length > 0 && block.cards.every((card) => isYearLabel(card.label));
      return (
        <section class={`article-block ${timelineCards ? "timeline-block" : ""}`}>
          {block.heading && <h2 id={headingId(block.heading)}>{block.heading}</h2>}
          <div class={`info-card-grid cols-${block.columns} ${timelineCards ? "is-timeline" : ""}`}>
            {block.cards.map((card) => (
              <article class={`info-card ${isYearLabel(card.label) ? "is-timeline" : ""}`}>
                {card.label && <span class="info-card-label">{card.label}</span>}
                <div class="info-card-copy">
                  <strong>{card.title}</strong>
                  <p>{card.text}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    }

    if (type === "factTiles" && block._type === "factTiles") {
      return (
        <section class="article-block stats-block">
          {block.heading && <h2 id={headingId(block.heading)}>{block.heading}</h2>}
          <div class="fact-tile-grid">
            {block.items.map((item) => (
              <div class="fact-tile">
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
        </section>
      );
    }

    if (type === "table" && block._type === "table") {
      return (
        <section class="article-block">
          {block.heading && <h2 id={headingId(block.heading)}>{block.heading}</h2>}
          {block.intro && <p>{block.intro}</p>}
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  {block.columns.map((column) => <th>{column}</th>)}
                </tr>
              </thead>
              <tbody>
                {block.rows.map((row) => (
                  <tr>
                    {block.columns.map((_, cellIndex) => (
                      <td>{row[cellIndex] ?? ""}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {block.footnote && <p class="table-footnote">{block.footnote}</p>}
        </section>
      );
    }

    if (type === "faq" && block._type === "faq") {
      return (
        <section class="article-block faq-block">
          {block.heading && <h2 id={headingId(block.heading)}>{block.heading}</h2>}
          <div class="faq-list">
            {block.items.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      );
    }

    if (type === "cta" && block._type === "cta") {
      return (
        <section class="article-panel article-cta">
          <h2>{block.heading}</h2>
          {block.text && <p>{block.text}</p>}
          <div class="article-cta-actions">
            <a class="button button-primary" href={block.primary.href}>{block.primary.label}</a>
            {block.secondary && (
              <a class="button button-secondary" href={block.secondary.href}>{block.secondary.label}</a>
            )}
          </div>
        </section>
      );
    }

    if (type === "links" && block._type === "links") {
      return (
        <section class="article-block">
          {block.heading && <h2 id={headingId(block.heading)}>{block.heading}</h2>}
          <div class="article-links">
            {block.items.map((link) => {
              const external = isExternalHref(link.href);
              return (
                <a
                  href={link.href}
                  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {link.label}
                </a>
              );
            })}
          </div>
        </section>
      );
    }

    if (type === "linkCards" && block._type === "linkCards") {
      return (
        <section class="article-block hub-links">
          {(block.heading || block.intro) && (
            <div class="block-heading">
              {block.heading && <h2 id={headingId(block.heading)}>{block.heading}</h2>}
              {block.intro && <p>{block.intro}</p>}
            </div>
          )}
          <div class="hub-link-grid">
            {block.cards.map((page) => {
              const external = isExternalHref(page.href);
              const title = page.title || page.label || page.href;
              return (
                <a
                  class="hub-link-card"
                  href={page.href}
                  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {page.label && page.title && <span class="hub-link-label">{page.label}</span>}
                  <strong>{title}</strong>
                  {page.text && <p>{page.text}</p>}
                </a>
              );
            })}
          </div>
        </section>
      );
    }

    if (type === "symbolGallery" && block._type === "symbolGallery") {
      return (
        <section class="article-block symbol-gallery">
          {block.heading && <h2 id={headingId(block.heading)}>{block.heading}</h2>}
          {block.intro && <p>{block.intro}</p>}
          <div class="symbol-grid">
            {block.items.map((item) => (
              <figure class="symbol-card">
                <button
                  type="button"
                  data-full-image={item.image.src}
                  data-full-image-alt={item.image.alt}
                  aria-label={`Vis ${item.title} i full størrelse`}
                >
                  <span class="symbol-image">
                    <img src={item.image.src} alt={item.image.alt} loading="lazy" />
                  </span>
                </button>
                <figcaption>
                  {item.subtitle && <span class="symbol-meta">{item.subtitle}</span>}
                  <strong>{item.title}</strong>
                  {item.meaning && <p>{item.meaning}</p>}
                  {item.use && <p>{item.use}</p>}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      );
    }

    if (type === "tool" && block._type === "tool") {
      if (block.tool === "incoterms") {
        return (
          <>
            <IncotermsWizard />
            <section class="card incoterms-selector" id="incoterms-termer" data-incoterms-selector>
              <div class="calculator-heading">
                <p class="eyebrow">Termvelger</p>
                <h2>Se detaljer for hver Incoterms® 2020-term</h2>
                <p>
                  Velg en term for å se levering, risiko, kostnader, forsikring, eksport/import
                  og praktiske tips.
                </p>
              </div>
              <div class="term-tabs" role="tablist" aria-label="Velg Incoterms-term">
                {["EXW", "FCA", "FAS", "FOB", "CFR", "CIF", "CPT", "CIP", "DAP", "DPU", "DDP"].map((term) => (
                  <button type="button" data-incoterm-button={term} aria-pressed={term === "CIF" ? "true" : "false"}>
                    {term}
                  </button>
                ))}
              </div>
              <div class="term-panel">
                <figure class="term-graphic">
                  <img src="" alt="" data-incoterm-image loading="lazy" />
                </figure>
                <div class="term-copy">
                  <p class="term-mode" data-incoterm-mode></p>
                  <h3 data-incoterm-title></h3>
                  <p data-incoterm-summary></p>
                  <dl>
                    <div>
                      <dt>Risiko</dt>
                      <dd data-incoterm-risk></dd>
                    </div>
                    <div>
                      <dt>Kostnader</dt>
                      <dd data-incoterm-costs></dd>
                    </div>
                    <div>
                      <dt>Forsikring</dt>
                      <dd data-incoterm-insurance></dd>
                      <button
                        type="button"
                        class="term-cargo-link"
                        data-incoterm-cargo-link
                        data-full-image="/images/articles/marine-cargo-clauses.png"
                        data-full-image-alt="Oversikt over risikoer dekket av Institute Cargo Clauses A, B og C"
                        hidden
                      >
                        Se Institute Cargo Clauses A, B og C
                      </button>
                    </div>
                    <div>
                      <dt>Overlevering</dt>
                      <dd data-incoterm-delivery></dd>
                    </div>
                    <div>
                      <dt>Eksport og import</dt>
                      <dd data-incoterm-clearance></dd>
                    </div>
                  </dl>
                  <p class="term-note" data-incoterm-note></p>
                </div>
              </div>
            </section>
          </>
        );
      }

      if (block.tool === "liability") {
        return (
          <section class="card liability-calculator" data-liability-calculator>
            <div class="calculator-heading">
              <p class="eyebrow">Kalkulator</p>
              <h2>Beregn ansvarsgrense i NOK</h2>
              <p>
                Kalkulatoren beregner en omtrentlig øvre ansvarsgrense basert på SDR, vekt,
                transportmåte og eventuell skadeverdi. Den erstatter ikke konkret vurdering av
                ansvar, skyld, vilkår eller forsikring.
              </p>
            </div>
            <form class="calculator-form">
              <label>
                Transportmåte
                <select name="mode" data-liability-mode>
                  <option value="road-domestic">Vei innenriks - 17 SDR/kg</option>
                  <option value="road-international">Vei internasjonalt - 8,33 SDR/kg</option>
                  <option value="sea-domestic">Sjø innenriks - 17 SDR/kg</option>
                  <option value="sea-international">Sjø internasjonalt - 667 SDR/kolli eller 2 SDR/kg</option>
                  <option value="air-international">Flyfrakt internasjonalt - 26 SDR/kg</option>
                </select>
              </label>
              <label>
                Skadedato
                <input type="date" name="damageDate" data-liability-date />
              </label>
              <label>
                Bruttovekt skadet/tapt gods (kg)
                <input type="text" name="weight" inputmode="decimal" autocomplete="off" placeholder="F.eks. 1 250" data-liability-weight />
              </label>
              <label data-packages-field hidden>
                Antall kolli/enheter (kun sjø internasjonalt)
                <input type="number" name="packages" min="1" step="1" value="1" data-liability-packages />
              </label>
              <label>
                Eventuell skadeverdi i NOK
                <input type="text" name="damageValue" inputmode="decimal" autocomplete="off" placeholder="Valgfritt, f.eks. 75 000" data-liability-damage />
              </label>
              <input type="hidden" name="sdrRate" data-liability-rate />
              <div class="calculator-actions">
                <button type="submit">Beregn ansvarsgrense</button>
              </div>
            </form>
            <p class="calculator-status" data-liability-status>
              SDR-kurs hentes online når siden lastes.
            </p>
            <div class="calculator-result" data-liability-result hidden></div>
          </section>
        );
      }

      if (block.tool === "volumeWeight") {
        return (
          <section class="article-panel article-cta">
            <p class="eyebrow">Verktøy</p>
            <h2>Volumvekt-kalkulator</h2>
            <p>
              Beregn volumvekt og nyttig last for kapelltralle og stykkegods. Åpne den komplette
              kalkulatoren for dimensjoner, omregning og praktiske eksempler.
            </p>
            <div class="article-cta-actions">
              <a
                class="button button-primary"
                href="/kjekt-a-vite/kapelltralle-dimensjoner-volumvekt-kalkulator"
              >
                Åpne volumvekt-kalkulator
              </a>
            </div>
          </section>
        );
      }

      return null;
    }

    const section = block as ArticleSectionBlock;
    return (
      <>
        <section class="article-flow-section">
          {section.heading && <h2 id={headingId(section.heading)}>{section.heading}</h2>}
          {section.text && (
            <div class="richtext" set:html={paragraphsFromPlainText(section.text)} />
          )}
          {section.items && (
            <ul>
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          )}
          {section.links && (
            <div class="article-links">
              {section.links.map((link) => {
                const external = isExternalHref(link.href);
                return (
                  <a
                    href={link.href}
                    {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  >
                    {link.label}
                  </a>
                );
              })}
            </div>
          )}
          {section.image && (
            <figure class="article-inline-image">
              <button
                type="button"
                data-full-image={section.image.src}
                data-full-image-alt={section.image.alt}
                aria-label="Vis bildet i full størrelse"
              >
                <img src={section.image.src} alt={section.image.alt} loading="lazy" />
              </button>
              {section.image.caption && <figcaption>{section.image.caption}</figcaption>}
            </figure>
          )}
        </section>
        {showLegacyIncoterms && index === 0 && (
          <>
            <IncotermsWizard />
            <section class="card incoterms-selector" id="incoterms-termer" data-incoterms-selector>
              <div class="calculator-heading">
                <p class="eyebrow">Termvelger</p>
                <h2>Se detaljer for hver Incoterms® 2020-term</h2>
                <p>
                  Velg en term for å se levering, risiko, kostnader, forsikring, eksport/import
                  og praktiske tips.
                </p>
              </div>
              <div class="term-tabs" role="tablist" aria-label="Velg Incoterms-term">
                {["EXW", "FCA", "FAS", "FOB", "CFR", "CIF", "CPT", "CIP", "DAP", "DPU", "DDP"].map((term) => (
                  <button type="button" data-incoterm-button={term} aria-pressed={term === "CIF" ? "true" : "false"}>
                    {term}
                  </button>
                ))}
              </div>
              <div class="term-panel">
                <figure class="term-graphic">
                  <img src="" alt="" data-incoterm-image loading="lazy" />
                </figure>
                <div class="term-copy">
                  <p class="term-mode" data-incoterm-mode></p>
                  <h3 data-incoterm-title></h3>
                  <p data-incoterm-summary></p>
                  <dl>
                    <div>
                      <dt>Risiko</dt>
                      <dd data-incoterm-risk></dd>
                    </div>
                    <div>
                      <dt>Kostnader</dt>
                      <dd data-incoterm-costs></dd>
                    </div>
                    <div>
                      <dt>Forsikring</dt>
                      <dd data-incoterm-insurance></dd>
                      <button
                        type="button"
                        class="term-cargo-link"
                        data-incoterm-cargo-link
                        data-full-image="/images/articles/marine-cargo-clauses.png"
                        data-full-image-alt="Oversikt over risikoer dekket av Institute Cargo Clauses A, B og C"
                        hidden
                      >
                        Se Institute Cargo Clauses A, B og C
                      </button>
                    </div>
                    <div>
                      <dt>Overlevering</dt>
                      <dd data-incoterm-delivery></dd>
                    </div>
                    <div>
                      <dt>Eksport og import</dt>
                      <dd data-incoterm-clearance></dd>
                    </div>
                  </dl>
                  <p class="term-note" data-incoterm-note></p>
                </div>
              </div>
            </section>
          </>
        )}
      </>
    );
  })
}

{showLegacyLiability && (
  <section class="card liability-calculator" data-liability-calculator>
    <div class="calculator-heading">
      <p class="eyebrow">Kalkulator</p>
      <h2>Beregn ansvarsgrense i NOK</h2>
      <p>
        Kalkulatoren beregner en omtrentlig øvre ansvarsgrense basert på SDR, vekt,
        transportmåte og eventuell skadeverdi. Den erstatter ikke konkret vurdering av
        ansvar, skyld, vilkår eller forsikring.
      </p>
    </div>
    <form class="calculator-form">
      <label>
        Transportmåte
        <select name="mode" data-liability-mode>
          <option value="road-domestic">Vei innenriks - 17 SDR/kg</option>
          <option value="road-international">Vei internasjonalt - 8,33 SDR/kg</option>
          <option value="sea-domestic">Sjø innenriks - 17 SDR/kg</option>
          <option value="sea-international">Sjø internasjonalt - 667 SDR/kolli eller 2 SDR/kg</option>
          <option value="air-international">Flyfrakt internasjonalt - 26 SDR/kg</option>
        </select>
      </label>
      <label>
        Skadedato
        <input type="date" name="damageDate" data-liability-date />
      </label>
      <label>
        Bruttovekt skadet/tapt gods (kg)
        <input type="text" name="weight" inputmode="decimal" autocomplete="off" placeholder="F.eks. 1 250" data-liability-weight />
      </label>
      <label data-packages-field hidden>
        Antall kolli/enheter (kun sjø internasjonalt)
        <input type="number" name="packages" min="1" step="1" value="1" data-liability-packages />
      </label>
      <label>
        Eventuell skadeverdi i NOK
        <input type="text" name="damageValue" inputmode="decimal" autocomplete="off" placeholder="Valgfritt, f.eks. 75 000" data-liability-damage />
      </label>
      <input type="hidden" name="sdrRate" data-liability-rate />
      <div class="calculator-actions">
        <button type="submit">Beregn ansvarsgrense</button>
      </div>
    </form>
    <p class="calculator-status" data-liability-status>
      SDR-kurs hentes online når siden lastes.
    </p>
    <div class="calculator-result" data-liability-result hidden></div>
  </section>
)}

<style>
  .article-flow,
  .article-flow-section,
  .article-block { max-width: 76ch; }
  .article-panel {
    margin: 0;
    padding: 22px 22px 22px 20px;
    border-radius: 18px;
    border-left: 4px solid #064f2f;
    background: #eaf5ee;
  }
  .notice strong { display: block; color: #064f2f; margin-bottom: 8px; }
  .notice-warning,
  .warning-box {
    background: #fff8e6;
    border-left-color: #c98500;
  }
  .notice-tip {
    background: #eaf5ee;
    border-left-color: #064f2f;
  }
  .checklist ul,
  .warning-box ul { margin-top: 12px; }
  h2 { color: var(--black); margin-bottom: 12px; scroll-margin-top: 120px; }
  p, li { color: var(--text); line-height: 1.75; }
  ul { margin: 16px 0 0; padding-left: 22px; }
  .info-card-grid,
  .fact-tile-grid,
  .symbol-grid,
  .hub-link-grid {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }
  .info-card-grid.cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .info-card-grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .info-card,
  .fact-tile,
  .symbol-card,
  .hub-link-card {
    padding: 18px;
    border-radius: 18px;
    background: #fff;
    border: 1px solid rgba(6, 79, 47, .1);
  }
  .info-card-label,
  .hub-link-label {
    display: inline-flex;
    width: fit-content;
    padding: 6px 10px;
    border-radius: 999px;
    background: #eaf5ee;
    color: var(--green);
    font-size: .75rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .info-card strong,
  .symbol-card strong { color: var(--black); display: block; margin: 8px 0; }
  .info-card p { margin: 0; }
  .fact-tile {
    display: grid;
    gap: 10px;
    padding: 24px;
    box-shadow: 0 16px 42px rgba(8, 32, 25, .05);
  }
  .fact-tile strong {
    color: #064f2f;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    line-height: 1;
    letter-spacing: -.05em;
    margin: 0;
  }
  .fact-tile span {
    color: #52645d;
    font-size: .95rem;
    font-weight: 500;
    line-height: 1.45;
    text-transform: none;
    letter-spacing: 0;
  }
  .fact-tile-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: none;
  }
  .stats-block { max-width: none; }
  .timeline-block {
    max-width: none;
    margin-top: 12px;
    padding: 24px;
    border: 1px solid rgba(6, 79, 47, .12);
    border-radius: 24px;
    background: #f8fbf9;
  }
  .timeline-block h2 { margin-top: 0; }
  .info-card-grid.is-timeline {
    gap: 10px;
  }
  .info-card.is-timeline {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
    padding: 13px;
    border-radius: 16px;
    align-items: start;
  }
  .info-card.is-timeline .info-card-label {
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: #064f2f;
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -.03em;
    text-transform: none;
  }
  .info-card.is-timeline .info-card-copy {
    display: grid;
    gap: 4px;
  }
  .info-card.is-timeline strong {
    margin: 0;
    color: #064f2f;
    font-size: .95rem;
    line-height: 1.2;
  }
  .info-card.is-timeline p {
    color: #33443d;
    font-size: .9rem;
