---
import roadImage from '../assets/images/logistics/road-freight.svg';
import seaImage from '../assets/images/logistics/sea-freight.svg';
import airImage from '../assets/images/logistics/air-freight.svg';
import projectImage from '../assets/images/logistics/project-cargo.svg';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  variant?: 'road' | 'sea' | 'air' | 'project';
  image?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  eyebrow,
  title,
  lead,
  variant = 'road',
  image,
  imageAlt = '',
} = Astro.props;

const fallbackImages = {
  road: roadImage,
  sea: seaImage,
  air: airImage,
  project: projectImage,
};

const resolvedImage =
  typeof image === 'string'
    ? { src: image }
    : image ?? fallbackImages[variant];
---

<section class="service-hero section-shell">
  <div class="service-hero__text">
    <p class="service-eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <div class="lead">{lead}</div>
  </div>
  <div class="service-hero__media">
    <img
      src={resolvedImage.src}
      alt={imageAlt}
      loading="eager"
      decoding="async"
    />
  </div>
</section>

<style>
  .service-hero.section-shell {
    width: min(100% - clamp(2rem, 6vw, 7rem), var(--max-width, 1200px));
    margin-inline: auto;
  }

  .service-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(380px, 1.15fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4rem);
    --accent: var(--green);
  }

  .service-hero__text {
    max-width: 900px;
  }

  .service-hero .service-eyebrow {
    color: var(--green);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 0.9rem;
    font-size: 0.75rem;
  }

  h1 {
    max-width: 980px;
    font-size: clamp(2.1rem, 4.2vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    margin: 0;
    color: var(--black);
  }

  .lead {
    max-width: 760px;
    margin-top: 1.6rem;
    color: var(--text);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.7;
  }

  .service-hero__media {
    overflow: hidden;
    border-radius: 30px;
    box-shadow: 0 24px 70px rgba(43, 41, 38, 0.14);
    border: 1px solid var(--border);
    background: var(--light);
    min-height: 480px;
  }

  .service-hero__media img {
    width: 100%;
    height: 100%;
    min-height: 480px;
    max-height: 560px;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 900px) {
    .service-hero {
      grid-template-columns: 1fr;
    }

    .service-hero__media,
    .service-hero__media img {
      min-height: 380px;
      max-height: 420px;
    }
  }

  @media (max-width: 640px) {
    .service-hero.section-shell {
      width: min(100% - 2rem, var(--max-width, 1200px));
    }

    .service-hero__media {
      border-radius: 22px;
    }

    .service-hero__media,
    .service-hero__media img {
      min-height: 280px;
      max-height: 320px;
    }
  }
</style>
