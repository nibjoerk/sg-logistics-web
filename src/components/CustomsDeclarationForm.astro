---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<section class="customs-lookup" data-customs-lookup data-turnstile-sitekey={turnstileSiteKey}>
  <div class="customs-intro">
    <p class="eyebrow">Selvbetjening</p>
    <h1>Hent tolldeklarasjon</h1>
    <p>
      Oppgi ekspedisjonsnummer og løpenummer fra deklarasjonsoversikten i
      Altinn (fra Tolletaten), samt organisasjonsnummer og statistisk verdi som
      sikkerhetskode. Du får PDF-en lastet ned hvis opplysningene stemmer.
    </p>
  </div>

  <form class="customs-form" data-customs-form novalidate>
    <div class="field-grid">
      <div class="field">
        <label for="customs-eksp">Ekspedisjonsnummer</label>
        <input
          id="customs-eksp"
          name="expeditionNo"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="6 siffer"
          maxlength="6"
          required
          data-field="expeditionNo"
        />
      </div>
      <div class="field">
        <label for="customs-lopenr">Løpenummer</label>
        <input
          id="customs-lopenr"
          name="serialNo"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="10 siffer"
          maxlength="10"
          required
          data-field="serialNo"
        />
      </div>
      <div class="field">
        <label for="customs-org">Organisasjonsnummer</label>
        <input
          id="customs-org"
          name="orgNo"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="9 siffer"
          required
          data-field="orgNo"
        />
      </div>
      <div class="field">
        <label for="customs-verdi">Statistisk verdi</label>
        <input
          id="customs-verdi"
          name="totalValue"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="Fra oversikten"
          required
          data-field="totalValue"
        />
      </div>
    </div>

    {turnstileSiteKey ? (
      <div class="customs-turnstile">
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme="light"
          data-customs-turnstile
        ></div>
      </div>
    ) : null}

    <p class="form-error" data-customs-error hidden role="alert"></p>
    <p class="form-info" data-customs-info hidden></p>

    <div class="form-actions">
      <button type="submit" class="button button-primary" data-customs-submit>
        Last ned deklarasjon
      </button>
    </div>
  </form>

  <aside class="customs-help">
    <h2>Hvor finner jeg nummerne?</h2>
    <figure class="customs-example">
      <img
        src="/images/customs/deklarasjonsoversikt-eksempel.png"
        alt="Eksempel på deklarasjonsoversikt fra Tolletaten via Altinn, med Eksp.nr, Løpenr., organisasjonsnummer og Statistisk verdi markert."
        loading="lazy"
      />
      <figcaption>
        Eksempel på deklarasjonsoversikt som du mottar fra Tolletaten via Altinn.
        Bruk <strong>Eksp.nr</strong>, <strong>Løpenr.</strong>,
        organisasjonsnummer og <strong>Statistisk verdi</strong>.
      </figcaption>
    </figure>
    <p>Kun deklarasjoner fra de siste tre månedene er tilgjengelige her.</p>
    <p>Finner du ikke dokumentet? Kontakt oss, så hjelper vi deg.</p>
    <a class="button button-primary customs-contact" href="/#kontakt">Kontakt oss</a>
  </aside>

  <dialog class="customs-pref-dialog" data-customs-pref-dialog>
    <form class="customs-pref-panel" data-customs-pref-form>
      <h2>Automatisk utsending?</h2>
      <p>
        Ønsker du at vi skal sende fremtidige tolldeklarasjoner til deg
        automatisk? Legg inn en e-postadresse her, så oppdaterer vi systemet
        vårt.
      </p>
      <div class="field">
        <label for="customs-pref-email">E-postadresse</label>
        <input
          id="customs-pref-email"
          type="email"
          name="email"
          autocomplete="email"
          placeholder="epost@bedrift.no"
          required
          data-customs-pref-email
        />
      </div>
      <p class="form-error" data-customs-pref-error hidden role="alert"></p>
      <p class="form-info" data-customs-pref-info hidden></p>
      <div class="customs-pref-actions">
        <button type="submit" class="button button-primary" data-customs-pref-submit>
          Send
        </button>
        <button type="button" class="button button-secondary" data-customs-pref-dismiss value="cancel">
          Nei takk
        </button>
      </div>
    </form>
  </dialog>
</section>

{turnstileSiteKey ? (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
) : null}

<script>
  const root = document.querySelector<HTMLElement>("[data-customs-lookup]");
  if (root) {
    const form = root.querySelector<HTMLFormElement>("[data-customs-form]");
    const errorEl = root.querySelector<HTMLElement>("[data-customs-error]");
    const infoEl = root.querySelector<HTMLElement>("[data-customs-info]");
    const submitBtn = root.querySelector<HTMLButtonElement>("[data-customs-submit]");
    const prefDialog = root.querySelector<HTMLDialogElement>("[data-customs-pref-dialog]");
    const prefForm = root.querySelector<HTMLFormElement>("[data-customs-pref-form]");
    const prefEmail = root.querySelector<HTMLInputElement>("[data-customs-pref-email]");
    const prefError = root.querySelector<HTMLElement>("[data-customs-pref-error]");
    const prefInfo = root.querySelector<HTMLElement>("[data-customs-pref-info]");
    const prefSubmit = root.querySelector<HTMLButtonElement>("[data-customs-pref-submit]");
    const prefDismiss = root.querySelector<HTMLButtonElement>("[data-customs-pref-dismiss]");
    const turnstileSiteKey = root.dataset.turnstileSitekey ?? "";

    type TurnstileApi = {
      getResponse: (widgetId?: string) => string;
      reset: (widgetId?: string) => void;
    };

    function turnstileApi(): TurnstileApi | undefined {
      return (window as unknown as { turnstile?: TurnstileApi }).turnstile;
    }

    let lastLookup: {
      expeditionNo: string;
      serialNo: string;
      orgNo: string;
      totalValue: string;
    } | null = null;

    function getTurnstileToken(): string {
      if (!turnstileSiteKey) return "";
      const input = form?.querySelector<HTMLInputElement>(
        '[name="cf-turnstile-response"]',
      );
      if (input?.value) return input.value;
      try {
        return turnstileApi()?.getResponse() ?? "";
      } catch {
        return "";
      }
    }

    function resetTurnstile() {
      if (!turnstileSiteKey) return;
      try {
        turnstileApi()?.reset();
      } catch {
        /* widget may not be ready */
      }
    }

    function showError(message: string) {
      if (infoEl) {
        infoEl.hidden = true;
        infoEl.textContent = "";
      }
      if (errorEl) {
        errorEl.hidden = false;
        errorEl.textContent = message;
      }
    }

    function showInfo(message: string) {
      if (errorEl) {
        errorEl.hidden = true;
        errorEl.textContent = "";
      }
      if (infoEl) {
        infoEl.hidden = false;
        infoEl.textContent = message;
      }
    }

    function clearMessages() {
      if (errorEl) {
        errorEl.hidden = true;
        errorEl.textContent = "";
      }
      if (infoEl) {
        infoEl.hidden = true;
        infoEl.textContent = "";
      }
    }

    function clearPrefMessages() {
      if (prefError) {
        prefError.hidden = true;
        prefError.textContent = "";
      }
      if (prefInfo) {
        prefInfo.hidden = true;
        prefInfo.textContent = "";
      }
    }

    function openPrefDialog() {
      clearPrefMessages();
      if (prefEmail) prefEmail.value = "";
      if (prefSubmit) {
        prefSubmit.disabled = false;
        prefSubmit.textContent = "Send";
      }
      prefDialog?.showModal();
      prefEmail?.focus();
    }

    prefDismiss?.addEventListener("click", () => {
      prefDialog?.close();
    });

    prefDialog?.addEventListener("click", (event) => {
      if (event.target === prefDialog) prefDialog.close();
    });

    prefForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearPrefMessages();

      if (!lastLookup) {
        if (prefError) {
          prefError.hidden = false;
          prefError.textContent = "Oppslaget er utløpt. Last ned deklarasjonen på nytt.";
        }
        return;
      }

      const email = (prefEmail?.value ?? "").trim();
      if (!email) {
        if (prefError) {
          prefError.hidden = false;
          prefError.textContent = "Oppgi en e-postadresse.";
        }
        return;
      }

      if (prefSubmit) {
        prefSubmit.disabled = true;
        prefSubmit.textContent = "Sender…";
      }

      try {
        const response = await fetch("/api/customs/email-preference", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...lastLookup, email }),
        });
        const data = (await response.json()) as { ok?: boolean; error?: string };

        if (!response.ok || !data.ok) {
          if (prefError) {
            prefError.hidden = false;
            prefError.textContent = data.error ?? "Kunne ikke sende. Prøv igjen.";
          }
          return;
        }

        if (prefInfo) {
          prefInfo.hidden = false;
          prefInfo.textContent = "Takk! Vi oppdaterer systemet vårt.";
        }
        if (prefSubmit) prefSubmit.textContent = "Sendt";
        window.setTimeout(() => prefDialog?.close(), 1400);
      } catch {
        if (prefError) {
          prefError.hidden = false;
          prefError.textContent = "Noe gikk galt. Prøv igjen senere.";
        }
      } finally {
        if (prefSubmit && prefSubmit.textContent !== "Sendt") {
          prefSubmit.disabled = false;
          prefSubmit.textContent = "Send";
        }
      }
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearMessages();

      const expeditionNo = (
        form.querySelector<HTMLInputElement>('[data-field="expeditionNo"]')?.value ?? ""
      ).trim();
      const serialNo = (
        form.querySelector<HTMLInputElement>('[data-field="serialNo"]')?.value ?? ""
      ).trim();
      const orgNo = (
        form.querySelector<HTMLInputElement>('[data-field="orgNo"]')?.value ?? ""
      ).trim();
      const totalValue = (
        form.querySelector<HTMLInputElement>('[data-field="totalValue"]')?.value ?? ""
      )
        .trim()
        .replace(/\s+/g, "");

      if (!expeditionNo || !serialNo || !orgNo || !totalValue) {
        showError("Fyll inn alle feltene.");
        return;
      }

      const turnstileToken = getTurnstileToken();
      if (turnstileSiteKey && !turnstileToken) {
        showError("Fullfør sikkerhetssjekken før du laster ned.");
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Henter…";
      }
      showInfo("Søker etter deklarasjon…");

      try {
        const response = await fetch("/api/customs/lookup", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            expeditionNo,
            serialNo,
            orgNo,
            totalValue,
            turnstileToken,
          }),
        });

        const contentType = response.headers.get("content-type") ?? "";

        if (!response.ok) {
          resetTurnstile();
          if (contentType.includes("application/json")) {
            const data = (await response.json()) as { error?: string };
            showError(data.error ?? "Fant ikke deklarasjon.");
          } else {
            showError("Fant ikke deklarasjon. Kontroller nummerne og prøv igjen.");
          }
          return;
        }

        if (!contentType.includes("application/pdf") && !contentType.includes("octet-stream")) {
          resetTurnstile();
          showError("Uventet svar fra serveren. Prøv igjen senere.");
          return;
        }

        const blob = await response.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `SAD-${expeditionNo.replace(/\D/g, "")}-${serialNo.replace(/\D/g, "")}.pdf`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        showInfo("Deklarasjonen er lastet ned.");
        lastLookup = { expeditionNo, serialNo, orgNo, totalValue };
        resetTurnstile();
        openPrefDialog();
      } catch {
        resetTurnstile();
        showError("Noe gikk galt. Sjekk nettforbindelsen og prøv igjen.");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Last ned deklarasjon";
        }
      }
    });
  }
</script>

<style>
  .customs-lookup {
    max-width: 720px;
  }

  .customs-intro {
    margin-bottom: 32px;
  }

  .customs-intro h1 {
    margin: 0 0 14px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--black);
  }

  .customs-intro p:last-child {
    margin: 0;
    color: var(--text);
    font-size: 1.08rem;
    max-width: 58ch;
  }

  .customs-example {
    margin: 16px 0 20px;
    max-width: 100%;
  }

  .customs-example img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
  }

  .customs-example figcaption {
    margin-top: 10px;
    font-size: 0.92rem;
    color: var(--text);
    max-width: 62ch;
  }

  .customs-help {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    max-width: 720px;
  }

  .customs-help h2 {
    margin: 0 0 10px;
    font-size: 1.2rem;
  }

  .customs-help p {
    margin: 0 0 12px;
    color: var(--text);
    max-width: 58ch;
  }

  .customs-contact {
    display: inline-flex;
    margin-top: 8px;
    text-decoration: none;
  }

  .customs-form {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: white;
  }

  .field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field label {
    display: block;
    margin-bottom: 6px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--dark);
  }

  .field input {
    width: 100%;
    min-height: 46px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    font: inherit;
    background: #fff;
  }

  .field input:focus {
    outline: 2px solid rgba(0, 150, 57, 0.35);
    border-color: var(--green);
  }

  .form-error,
  .form-info {
    margin: 16px 0 0;
    font-size: 0.95rem;
  }

  .form-error {
    color: #9b1c1c;
  }

  .form-info {
    color: var(--green-dark);
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .customs-turnstile {
    margin-top: 18px;
  }

  .customs-pref-dialog {
    border: none;
    border-radius: 18px;
    padding: 0;
    max-width: min(440px, calc(100vw - 32px));
    background: transparent;
  }

  .customs-pref-dialog::backdrop {
    background: rgba(43, 41, 38, 0.45);
  }

  .customs-pref-panel {
    margin: 0;
    padding: 28px 24px 24px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: #fff;
  }

  .customs-pref-panel h2 {
    margin: 0 0 10px;
    font-size: 1.25rem;
    color: var(--black);
  }

  .customs-pref-panel > p {
    margin: 0 0 18px;
    color: var(--text);
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .customs-pref-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .customs-pref-panel .form-error,
  .customs-pref-panel .form-info {
    margin-top: 12px;
  }

  @media (max-width: 640px) {
    .field-grid {
      grid-template-columns: 1fr;
    }

    .customs-form {
      padding: 18px;
    }
  }
</style>
