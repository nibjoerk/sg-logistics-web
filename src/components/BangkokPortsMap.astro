---
interface Props {
  title?: string;
  intro?: string;
  height?: string;
  showTransportLayers?: boolean;
}

const {
  title = "Havner og terminaler i Bangkok-regionen",
  intro = "Interaktiv oversikt over maritime og intermodale knutepunkter i Bangkok-regionen.",
  height = "clamp(560px, 72vh, 820px)",
  showTransportLayers = true,
} = Astro.props;
---

<section class="bangkok-map-block">
  <header class="bangkok-map__intro">
    <p class="bangkok-map__eyebrow">Thailand · logistikk</p>
    <h2>{title}</h2>
    <p>{intro}</p>
  </header>

  <div
    class="bangkok-map"
    style={`--map-height:${height}`}
    data-bangkok-map
    data-show-transport={showTransportLayers ? "true" : "false"}
  >
    <div
      class="bangkok-map__canvas"
      data-bangkok-map-canvas
      aria-label="Kart over havner og terminaler i Bangkok-regionen"
    ></div>

    <aside class="bangkok-map__legend" aria-label="Kartforklaring">
      <h3>Forklaring</h3>
      <div><span class="marker deepwater"></span>1. Laem Chabang Port</div>
      <div><span class="marker river-public"></span>2. PAT Bangkok Port</div>
      <div><span class="marker inland"></span>3. Lat Krabang ICD</div>
      <hr />
      <div><span class="marker bmt"></span>Bangkok Modern Terminal</div>
      <div><span class="marker sahathai"></span>Sahathai Terminal</div>
      <div><span class="marker unithai"></span>Unithai Container Terminal</div>
      <div><span class="marker siam"></span>Siam Seaport</div>
      {
        showTransportLayers && (
          <>
            <hr />
            <div><span class="route rail"></span>Jernbane (Eastern Line)</div>
            <div><span class="route barge"></span>Lekter / Chao Phraya</div>
            <div><span class="route road"></span>Vei LCB–Lat Krabang (Motorway 7)</div>
            <div><span class="route road-pat"></span>Vei LCB–PAT (Burapha Withi)</div>
          </>
        )
      }
    </aside>

    <p class="bangkok-map__note">
      Vei til Lat Krabang følger Motorway 7. Vei til PAT følger Motorway 7 / Burapha Withi. Jernbane følger Eastern Line. Lekter følger Chao Phraya.
    </p>
  </div>
</section>

