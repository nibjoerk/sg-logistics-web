    [13.67465, 100.83764],
    [13.68756, 100.83109],
    [13.69772, 100.8258],
    [13.70732, 100.81957],
    [13.71431, 100.81089],
    [13.71819, 100.80034],
    [13.72186, 100.78985],
    [13.72176, 100.77831],
    [13.72834, 100.78499],
    [13.73, 100.75],
    [13.733, 100.71],
    [13.735, 100.67],
    [13.732, 100.63],
    [13.725, 100.595],
    [13.715, 100.575],
    [13.704, 100.56],
  ];

  // Kyst- og elvetilhærming via Chao Phraya til BMT og PAT
  const bargeRoute = [
    [13.082, 100.883],
    [13.1, 100.87],
    [13.13, 100.85],
    [13.18, 100.82],
    [13.25, 100.78],
    [13.32, 100.73],
    [13.4, 100.68],
    [13.48, 100.64],
    [13.54, 100.61],
    [13.58, 100.59],
    [13.6, 100.58],
    [13.64, 100.57],
    [13.67, 100.565],
    [13.704, 100.56],
  ];

  const initBangkokPortsMap = (root) => {
    if (!(root instanceof HTMLElement) || root.dataset.initialized === "true") return;

    const canvas = root.querySelector("[data-bangkok-map-canvas]");
    if (!(canvas instanceof HTMLElement)) return;

    root.dataset.initialized = "true";
    const showTransportLayers = root.dataset.showTransport !== "false";

    // Must set center/zoom before adding circleMarkers, otherwise Leaflet's
    // SVG renderer has no bounds and throws (_bounds.intersects).
    const map = L.map(canvas, {
      center: [13.4, 100.72],
      zoom: 9,
      zoomControl: false,
      scrollWheelZoom: false,
    });

    L.control.zoom({ position: "topleft" }).addTo(map);

    L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
      subdomains: "abcd",
      maxZoom: 20,
      attribution: "&copy; OpenStreetMap contributors &copy; CARTO",
    }).addTo(map);

    const refreshSize = () => map.invalidateSize();
    refreshSize();

    const portLayer = L.layerGroup().addTo(map);

    ports.forEach((port) => {
      L.circleMarker(port.position, {
        radius: 10,
        color: "#ffffff",
        weight: 3,
        fillColor: port.color,
        fillOpacity: 1,
      })
        .addTo(portLayer)
        .bindTooltip(`${port.number}. ${port.name}`, { direction: "top" })
        .bindPopup(`
          <article class="port-popup">
            <span class="port-popup__badge" style="background:${port.color}">${port.type}</span>
            <h3>${port.number}. ${port.name}</h3>
            <p class="port-popup__aliases">${port.aliases}</p>
            <p>${port.description}</p>
          </article>
        `);
    });

    const overlays = { "Havner og terminaler": portLayer };

    if (showTransportLayers) {
      const rail = L.polyline(railRoute, {
        color: "#d97706",
        weight: 5,
        opacity: 0.9,
      })
        .addTo(map)
        .bindPopup(
          "<strong>Jernbane / Eastern Line</strong><br>Godskorridor mellom Laem Chabang og Lat Krabang ICD (SRT).",
        );

      const barge = L.polyline(bargeRoute, {
        color: "#0f766e",
        weight: 5,
        opacity: 0.85,
      })
        .addTo(map)
        .bindPopup(
          "<strong>Lekter / elveforbindelse</strong><br>Kyst- og Chao Phraya-trasé mot BMT og PAT Bangkok Port.",
        );

      const road = L.polyline(roadRoute, {
        color: "#475569",
        weight: 4,
        dashArray: "9 8",
        opacity: 0.85,
      })
        .addTo(map)
        .bindPopup(
          "<strong>Vei / Motorway 7</strong><br>Kjøretrasé langs Bangkok–Chonburi-korridoren mot Lat Krabang og Bangkok.",
        );

      overlays["Jernbane"] = rail;
      overlays["Lekter / elv"] = barge;
      overlays["Vei"] = road;
    }

    const bounds = L.latLngBounds(ports.map((port) => port.position));
    map.fitBounds(bounds, {
      paddingTopLeft: [24, 24],
      paddingBottomRight: [190, 170],
    });
    L.control.layers(undefined, overlays, { collapsed: true, position: "topright" }).addTo(map);

    window.requestAnimationFrame(refreshSize);
    window.setTimeout(refreshSize, 120);

    canvas.addEventListener("mouseenter", () => map.scrollWheelZoom.enable());
    canvas.addEventListener("mouseleave", () => map.scrollWheelZoom.disable());
    window.addEventListener("resize", refreshSize);
  };

  const initAll = () => {
    document.querySelectorAll("[data-bangkok-map]").forEach((root) => initBangkokPortsMap(root));
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll, { once: true });
  } else {
    initAll();
  }

  document.addEventListener("astro:page-load", initAll);
</script>

<style>
  .bangkok-map-block {
    display: grid;
    gap: 14px;
  }

  .bangkok-map__intro {
    padding: 0 2px;
  }

  .bangkok-map__intro h2 {
    margin: 0;
    color: #172033;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.15;
  }

  .bangkok-map__intro p {
    margin: 0.55rem 0 0;
    color: #526071;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .bangkok-map__intro .bangkok-map__eyebrow {
    margin: 0 0 0.35rem;
    color: #475569;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bangkok-map {
    position: relative;
    height: var(--map-height);
    min-height: 560px;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 1.25rem;
    background: #eef2f6;
  }

  .bangkok-map__canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }

  .bangkok-map__legend,
  .bangkok-map__note {
    position: absolute;
    z-index: 500;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.14);
  }

  .bangkok-map__legend {
    right: 1rem;
    bottom: 1rem;
    padding: 0.9rem 1rem;
    border-radius: 0.9rem;
    color: #334155;
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .bangkok-map__legend h3 {
    margin: 0 0 0.35rem;
    color: #172033;
    font-size: 0.85rem;
  }

  .bangkok-map__legend hr {
    margin: 0.5rem 0;
    border: 0;
    border-top: 1px solid #e2e8f0;
  }

  .marker {
    display: inline-block;
    width: 0.68rem;
    height: 0.68rem;
    margin-right: 0.45rem;
    border-radius: 999px;
    vertical-align: -0.04rem;
  }

  .river-public {
    background: #2563eb;
  }
  .river-private {
    background: #0f766e;
  }
  .inland {
    background: #d97706;
  }
  .deepwater {
    background: #7c3aed;
  }
  .deepwater-private {
    background: #be123c;
  }

  .route {
    display: inline-block;
    width: 1.55rem;
    margin-right: 0.45rem;
    border-top: 0.22rem solid;
    vertical-align: 0.18rem;
  }

  .rail {
    border-color: #d97706;
  }
  .barge {
    border-color: #0f766e;
  }
  .road {
    border-color: #475569;
    border-top-style: dashed;
  }

  .bangkok-map__note {
    left: 1rem;
    bottom: 1rem;
    margin: 0;
    max-width: min(22rem, calc(100% - 12rem));
    padding: 0.5rem 0.7rem;
    border-radius: 0.65rem;
    color: #64748b;
    font-size: 0.7rem;
    line-height: 1.4;
  }

  :global(.port-popup h3) {
    margin: 0.55rem 0 0.1rem;
    color: #172033;
    font-size: 1rem;
  }

  :global(.port-popup p) {
    margin: 0.55rem 0 0;
    line-height: 1.4;
  }

  :global(.port-popup__aliases) {
    color: #64748b;
    font-size: 0.78rem;
  }

  :global(.port-popup__badge) {
    display: inline-block;
    padding: 0.22rem 0.48rem;
    border-radius: 999px;
    color: white;
    font-size: 0.65rem;
    font-weight: 700;
  }

  :global(.leaflet-control-layers),
  :global(.leaflet-bar) {
    border: 0 !important;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.16) !important;
  }

  :global(.leaflet-control-layers),
  :global(.leaflet-bar),
  :global(.leaflet-popup),
  :global(.leaflet-tooltip) {
    pointer-events: auto;
  }

  @media (max-width: 700px) {
    .bangkok-map {
      min-height: 620px;
      border-radius: 0.9rem;
    }

    .bangkok-map__legend {
      right: 0.65rem;
      bottom: 0.65rem;
      font-size: 0.72rem;
    }

    .bangkok-map__note {
      display: none;
    }
  }
</style>
