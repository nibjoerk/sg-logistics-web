      const barge = L.polyline(bargeRoute, {
        color: "#0f766e",
        weight: 5,
        opacity: 0.9,
        smoothFactor: 0,
      })
        .addTo(map)
        .bindPopup(
          "<strong>Lekter / elveforbindelse</strong><br>Kystinnseiling og Chao Phraya-elven til PAT Bangkok Port.",
        );

      const road = L.polyline(roadRoute, {
        color: "#475569",
        weight: 4,
        dashArray: "9 8",
        opacity: 0.85,
        smoothFactor: 0,
      })
        .addTo(map)
        .bindPopup(
          "<strong>Vei LCB–Lat Krabang</strong><br>Motorway 7 (Route 7), tilsvarende Google Maps-korridoren (~107 km).",
        );

      const roadToPat = L.polyline(roadRouteToPat, {
        color: "#334155",
        weight: 4,
        dashArray: "2 10",
        opacity: 0.8,
        smoothFactor: 0,
      })
        .addTo(map)
        .bindPopup(
          "<strong>Vei LCB–PAT Bangkok</strong><br>Motorway 7 og Burapha Withi Expressway (Route 34), tilsvarende Google Maps-korridoren (~116 km).",
        );

      overlays["Jernbane"] = rail;
      overlays["Lekter / elv"] = barge;
      overlays["Vei til Lat Krabang"] = road;
      overlays["Vei til PAT Bangkok"] = roadToPat;
    }

    const bounds = L.latLngBounds([
      ...ports.map((port) => port.position),
      ...secondaryTerminals.map((terminal) => terminal.position),
    ]);
    map.fitBounds(bounds, {
      paddingTopLeft: [24, 24],
      paddingBottomRight: [190, 170],
    });
    L.control.layers(undefined, overlays, { collapsed: true, position: "topright" }).addTo(map);

    window.requestAnimationFrame(refreshSize);
    window.setTimeout(refreshSize, 120);

    canvas.addEventListener("mouseenter", () => map.scrollWheelZoom.enable());
    canvas.addEventListener("mouseleave", () => map.scrollWheelZoom.disable());
    window.addEventListener("resize", refreshSize);
  };

  const initAll = () => {
    document.querySelectorAll("[data-bangkok-map]").forEach((root) => initBangkokPortsMap(root));
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll, { once: true });
  } else {
    initAll();
  }

  document.addEventListener("astro:page-load", initAll);
</script>

