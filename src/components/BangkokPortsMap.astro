            <span class="port-popup__badge" style="background:${terminal.color}">${terminal.type}</span>
            <h3>${terminal.name}</h3>
            <p class="port-popup__aliases">${terminal.aliases}</p>
            <p>${terminal.description}</p>
          </article>
        `);
    });

    const overlays = {
      "Hovedhavner": portLayer,
      "Øvrige terminaler": terminalLayer,
    };

    if (showTransportLayers) {
      const rail = L.polyline(railRoute, {
        color: "#d97706",
        weight: 5,
        opacity: 0.9,
        smoothFactor: 0,
      })
        .addTo(map)
        .bindPopup(
          "<strong>Jernbane / Eastern Line</strong><br>Godskorridor mellom Laem Chabang og Lat Krabang ICD (SRT).",
