---
interface Props {
  title?: string;
  intro?: string;
  height?: string;
  showTransportLayers?: boolean;
}

const {
  title = "Havner og terminaler i Bangkok-regionen",
  intro = "Interaktiv oversikt over maritime og intermodale knutepunkter i Bangkok-regionen.",
  height = "clamp(560px, 72vh, 820px)",
  showTransportLayers = true,
} = Astro.props;
---

<section class="bangkok-map-block">
  <header class="bangkok-map__intro">
    <p class="bangkok-map__eyebrow">Thailand · logistikk</p>
    <h2>{title}</h2>
    <p>{intro}</p>
  </header>

  <div
    class="bangkok-map"
    style={`--map-height:${height}`}
    data-bangkok-map
    data-show-transport={showTransportLayers ? "true" : "false"}
  >
    <div
      class="bangkok-map__canvas"
      data-bangkok-map-canvas
      aria-label="Kart over havner og terminaler i Bangkok-regionen"
    ></div>

    <aside class="bangkok-map__legend" aria-label="Kartforklaring">
      <h3>Forklaring</h3>
      <div><span class="marker river-public"></span>PAT Bangkok Port</div>
      <div><span class="marker inland"></span>Lat Krabang ICD</div>
      <div><span class="marker river-private"></span>Bangkok Modern Terminal</div>
      <div><span class="marker deepwater"></span>Laem Chabang Port</div>
      <div><span class="marker deepwater-private"></span>Siam Seaport</div>
      {
        showTransportLayers && (
          <>
            <hr />
            <div><span class="route rail"></span>Jernbane (Eastern Line)</div>
            <div><span class="route barge"></span>Lekter / elv</div>
            <div><span class="route road"></span>Vei (Motorway 7)</div>
          </>
        )
      }
    </aside>

    <p class="bangkok-map__note">
      Vei følger Motorway 7 / Bang Na-korridoren. Jernbane følger Eastern Line mellom Laem Chabang og
      Lat Krabang. Hold musepekeren over kartet for å zoome.
    </p>
  </div>
</section>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  const ports = [
    {
      number: 1,
      name: "PAT Bangkok Port",
      aliases: "Khlong Toei / Klong Toey",
      type: "Statlig elvehavn",
      description: "Historisk hovedhavn ved Chao Phraya-elven i Bangkok.",
      position: [13.704, 100.56],
      color: "#2563eb",
    },
    {
      number: 2,
      name: "Lat Krabang ICD",
      aliases: "Bangkok ICD / LICD",
      type: "Tørrhavn / innlandsterminal",
      description: "Innlandsterminal med tollbehandling nær Suvarnabhumi.",
      position: [13.728, 100.785],
      color: "#d97706",
    },
    {
      number: 3,
      name: "Bangkok Modern Terminal",
      aliases: "BMT / BMTP",
      type: "Privat elvehavn",
      description: "Privat container- og bulkterminal i Samut Prakan.",
      position: [13.6, 100.58],
      color: "#0f766e",
    },
    {
      number: 4,
      name: "Laem Chabang Port",
      aliases: "LCB / Chonburi Port",
      type: "Dypvannshavn",
      description: "Thailands viktigste dypvannshavn for internasjonal containertrafikk.",
      position: [13.082, 100.883],
      color: "#7c3aed",
    },
    {
      number: 5,
      name: "Siam Seaport",
      aliases: "Sri Racha Port",
      type: "Privat dypvannshavn",
      description: "Havn for stykkgods, bulk, biler, tungindustri og containere.",
      position: [13.147, 100.889],
      color: "#be123c",
    },
  ];

  // SRT Eastern Line / godskorridor Laem Chabang -> Lat Krabang ICD
  const railRoute = [
    [13.082, 100.883],
    [13.095, 100.905],
    [13.12, 100.925],
    [13.15, 100.935],
    [13.174, 100.931],
    [13.21, 100.945],
    [13.25, 100.965],
    [13.29, 100.98],
    [13.33, 100.99],
    [13.361, 101.0],
    [13.41, 101.02],
    [13.46, 101.04],
    [13.51, 101.055],
    [13.56, 101.065],
    [13.61, 101.07],
    [13.65, 101.072],
    [13.688, 101.075],
    [13.705, 101.05],
    [13.715, 101.01],
    [13.722, 100.96],
    [13.725, 100.91],
    [13.726, 100.86],
    [13.727, 100.82],
    [13.728, 100.785],
  ];

  // OSRM-kjøretrasé langs Motorway 7 / Bangkok–Chonburi, deretter spur mot PAT
  const roadRoute = [
    [13.08173, 100.88209],
    [13.09159, 100.88681],
    [13.09798, 100.89987],
    [13.10291, 100.91021],
    [13.1059, 100.92108],
    [13.11043, 100.93192],
    [13.11029, 100.94324],
    [13.11207, 100.9543],
    [13.11439, 100.96625],
    [13.11657, 100.97728],
    [13.12469, 100.98493],
    [13.13816, 100.9854],
    [13.14978, 100.98589],
    [13.16055, 100.9887],
    [13.1735, 100.99294],
    [13.18469, 100.99653],
    [13.19691, 101.00056],
    [13.20877, 101.00441],
    [13.21986, 101.00477],
    [13.23025, 101.00082],
    [13.25085, 100.99284],
    [13.26221, 100.98961],
    [13.27635, 100.99046],
    [13.28805, 100.99122],
    [13.29879, 100.99471],
    [13.30771, 101.00191],
    [13.31684, 101.00892],
    [13.32636, 101.01626],
    [13.33585, 101.02224],
    [13.34558, 101.02838],
    [13.3561, 101.03495],
    [13.38422, 101.0452],
    [13.39648, 101.0472],
    [13.40821, 101.0471],
    [13.42198, 101.04672],
    [13.44081, 101.04611],
    [13.45426, 101.04607],
    [13.46691, 101.04591],
    [13.47938, 101.04622],
    [13.49057, 101.04674],
    [13.50079, 101.04119],
    [13.51125, 101.03236],
    [13.52856, 101.01777],
    [13.53738, 101.01036],
    [13.54623, 101.00295],
    [13.55516, 100.99532],
    [13.57132, 100.98185],
    [13.58025, 100.97434],
    [13.59149, 100.96487],
    [13.59907, 100.95412],
    [13.60896, 100.9387],
    [13.61505, 100.92923],
    [13.62408, 100.91515],
    [13.6306, 100.90501],
    [13.63683, 100.89529],
    [13.64301, 100.88567],
    [13.64911, 100.87618],
    [13.65542, 100.86633],
    [13.6616, 100.85671],
