  .bangkok-map__intro {
    padding: 0 2px;
  }

  .bangkok-map__intro h2 {
    margin: 0;
    color: #172033;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.15;
  }

  .bangkok-map__intro p {
    margin: 0.55rem 0 0;
    color: #526071;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .bangkok-map__intro .bangkok-map__eyebrow {
    margin: 0 0 0.35rem;
    color: #475569;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bangkok-map {
